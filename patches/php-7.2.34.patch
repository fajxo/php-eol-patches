 create mode 100644 ext/openssl/tests/gh22186.phpt

diff --git a/ext/openssl/openssl.c b/ext/openssl/openssl.c
index 4ef27124..4a0cb170 100644
--- a/ext/openssl/openssl.c
+++ b/ext/openssl/openssl.c
@@ -6521,6 +6521,7 @@ static int php_openssl_cipher_update(const EVP_CIPHER *cipher_type,
 		char *aad, size_t aad_len, int enc)  /* {{{ */
 {
 	int i = 0;
+	size_t outlen = data_len + EVP_CIPHER_block_size(cipher_type);
 
 	if (mode->is_single_run_aead && !EVP_CipherUpdate(cipher_ctx, NULL, &i, NULL, (int)data_len)) {
 		php_openssl_store_errors();
@@ -6534,7 +6535,19 @@ static int php_openssl_cipher_update(const EVP_CIPHER *cipher_type,
