+    echo "no connection\n";
+    exit(1);
+}
+fwrite($conn, "220 Ready\r\n");
+echo stream_get_line($conn, 8192, "\r\n"), "\n";
+fclose($conn);
+fclose($server);
+CODE;
+
+$proc = proc_open(escapeshellarg(PHP_BINARY) . ' -n -r ' . escapeshellarg($serverCode), [1 => ['pipe', 'w']], $pipes);
+$addr = trim(fgets($pipes[1]));
+
+var_dump(@fopen("FTPS://$addr/secret", 'r'));
+echo stream_get_contents($pipes[1]);
+fclose($pipes[1]);
+proc_close($proc);
+?>
+--EXPECT--
+bool(false)
+AUTH TLS
From 79a51c7ca9919024562b93a2bd99ca235571170b Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Thu, 19 Nov 2026 16:51:35 +0100
Subject: [PATCH 07/11] Fix GHSA-q23r-hr55-xmpg (CVE-2026-15353): OOB read on
 empty SOAP-ENC:arraySize

calc_dimension_12() returned 0 for an empty (or digit-less) SOAP 1.2
arraySize, and the array encoder/decoder then indexed a zero-length
dimension/position array, reading out of bounds.

Backport of php-src 382d249480 to 7.2.34: calc_dimension_12() returns
at least 1. to_zval_array()/to_xml_array() and the dimension helpers are
identical to 8.2, so the fix applies unchanged.

Tests GHSA-q23r-hr55-xmpg.phpt and GHSA-q23r-hr55-xmpg-wsdl.phpt (+ .wsdl)
adapted to 7.2 syntax: no flexible heredoc, no constructor property
promotion, strpos() instead of str_contains(), no return type on
__doRequest(); --EXTENSIONS-- replaced by SKIPIF (soap + json).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
