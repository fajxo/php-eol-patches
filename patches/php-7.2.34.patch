 ext/openssl/tests/san_no_cn_fallback.phpt     | 65 +++++++++++++++++++
 ext/openssl/tests/san_peer_matching.phpt      |  2 +-
 ext/openssl/tests/san_srv_no_cn_fallback.phpt | 58 +++++++++++++++++
 ext/openssl/tests/san_uri_no_cn_fallback.phpt | 58 +++++++++++++++++
 ext/openssl/xp_ssl.c                          | 28 +++++++-
 6 files changed, 269 insertions(+), 4 deletions(-)
