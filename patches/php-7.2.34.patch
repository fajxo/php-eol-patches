From 8ae6c464aef17b302cec7e825d2d35056dc04d03 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Wed, 25 Nov 2026 10:39:25 +0100
Subject: [PATCH] Fix GHSA-fpwc-w8rq-cr92 (CVE-2026-91766): cross-origin
 credentials

Authorization, Cookie and Proxy-Authorization set through the http
stream context were sent again when follow_location went to another
scheme, host or port, leaking them to the redirect target. They are now
stripped there, and stay stripped for the rest of the redirect chain,
also when the header name is repeated or the bag uses odd line endings.

Backport of php-src 5af9465ca8 (Alexandre Daubois, Jakub Zelenka),
Sury's 7.2 patch 0194 with the test fixes 0195 (Remi Collet) and 0215:
7.2 does not have GH-11274, so a 307 turns the POST into a GET without
a body, and the test expects that.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ext/standard/http_fopen_wrapper.c             | 111 ++++++++++---
 ext/standard/tests/http/bug61548.phpt         |   2 -
 .../tests/http/ghsa-fpwc-w8rq-cr92.phpt       | 157 ++++++++++++++++++
 3 files changed, 248 insertions(+), 22 deletions(-)
 create mode 100644 ext/standard/tests/http/ghsa-fpwc-w8rq-cr92.phpt

diff --git a/ext/standard/http_fopen_wrapper.c b/ext/standard/http_fopen_wrapper.c
index 5e173dc6..e40094f8 100644
--- a/ext/standard/http_fopen_wrapper.c
+++ b/ext/standard/http_fopen_wrapper.c
@@ -83,28 +83,70 @@
 
 #define HTTP_WRAPPER_HEADER_INIT    1
 #define HTTP_WRAPPER_REDIRECTED     2
+#define HTTP_WRAPPER_STRIP_AUTH     8
 
+static char *next_header_line(char *line)
+{
+	while (*line != '\0' && *line != '\r' && *line != '\n') {
+		line++;
+	}
+	if (*line == '\r') {
+		line++;
+	}
+	if (*line == '\n') {
+		line++;
+	}
+
+	return line;
+}
+
+/* Removes every line whose header name matches, along with the folded
+ * continuation lines carrying the rest of its value. Neither a repeated header
+ * nor an occurrence of the name inside another header's value may leave the real
+ * header behind, as that would defeat HTTP_WRAPPER_STRIP_AUTH. */
 static inline void strip_header(char *header_bag, char *lc_header_bag,
 		const char *lc_header_name)
 {
-	char *lc_header_start = strstr(lc_header_bag, lc_header_name);
-	char *header_start = header_bag + (lc_header_start - lc_header_bag);
+	size_t name_len = strlen(lc_header_name);
+	char *lc_line = lc_header_bag;
 
-	if (lc_header_start
