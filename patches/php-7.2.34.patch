From 95992a7f159e95263767a36452d76f3e0329f66b Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Tue, 24 Nov 2026 18:09:04 +0100
Subject: [PATCH] Fix GHSA-rgrp-mwpx-f6rm: unbounded recursion in SOAP XML
 parsing and decoding

A deeply nested SOAP document, or a long or cyclic chain of href
references, recursed without limit in cleanup_xml_node() and in the
decoder and crashed the worker on stack exhaustion. cleanup_xml_node() is
now iterative, documents nested deeper than SOAP_MAX_XML_DEPTH (2048) are
rejected with libxml2 before 2.13 (newer libxml2 limits depth itself),
and decoding, which follows href references, stops with a SOAP error past
SOAP_MAX_DECODE_DEPTH.

Backport of php-src 3655b79c7b (Alexandre Daubois), Sury's 7.2 patch
0158. One hunk is merged by hand: the iterative cleanup_xml_node() keeps
the XML_DTD_NODE branch that the GHSA-4646-p932-gw34 fix in this branch
added, as in Sury's later patch 0263.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ext/soap/php_encoding.c                       |   7 ++
 ext/soap/php_soap.h                           |   3 +
 ext/soap/php_xml.c                            | 102 ++++++++++++++----
 ext/soap/soap.c                               |   1 +
 .../tests/GHSA-rgrp-mwpx-f6rm-href-chain.phpt |  47 ++++++++
 .../tests/GHSA-rgrp-mwpx-f6rm-href-cycle.phpt |  43 ++++++++
 ext/soap/tests/GHSA-rgrp-mwpx-f6rm.phpt       |  89 +++++++++++++++
 7 files changed, 272 insertions(+), 20 deletions(-)
 create mode 100644 ext/soap/tests/GHSA-rgrp-mwpx-f6rm-href-chain.phpt
 create mode 100644 ext/soap/tests/GHSA-rgrp-mwpx-f6rm-href-cycle.phpt
 create mode 100644 ext/soap/tests/GHSA-rgrp-mwpx-f6rm.phpt

diff --git a/ext/soap/php_encoding.c b/ext/soap/php_encoding.c
index 19441f42..591d2c7e 100644
--- a/ext/soap/php_encoding.c
+++ b/ext/soap/php_encoding.c
@@ -560,7 +560,12 @@ static zval *master_to_zval_int(zval *ret, encodePtr encode, xmlNodePtr data)
 		}
 	}
 	if (encode->to_zval) {
+		if (SOAP_GLOBAL(decode_depth) >= SOAP_MAX_DECODE_DEPTH) {
+			soap_error0(E_ERROR, "Encoding: Nesting level too deep");
+		}
+		SOAP_GLOBAL(decode_depth)++;
 		ret = encode->to_zval(ret, &encode->details, data);
+		SOAP_GLOBAL(decode_depth)--;
 	}
 	return ret;
 }
@@ -3452,6 +3457,7 @@ void encode_reset_ns()
 {
 	SOAP_GLOBAL(cur_uniq_ns) = 0;
 	SOAP_GLOBAL(cur_uniq_ref) = 0;
+	SOAP_GLOBAL(decode_depth) = 0;
 	if (SOAP_GLOBAL(ref_map)) {
 		zend_hash_destroy(SOAP_GLOBAL(ref_map));
 	} else {
@@ -3464,6 +3470,7 @@ void encode_finish()
 {
 	SOAP_GLOBAL(cur_uniq_ns) = 0;
 	SOAP_GLOBAL(cur_uniq_ref) = 0;
+	SOAP_GLOBAL(decode_depth) = 0;
 	if (SOAP_GLOBAL(ref_map)) {
 		zend_hash_destroy(SOAP_GLOBAL(ref_map));
 		efree(SOAP_GLOBAL(ref_map));
diff --git a/ext/soap/php_soap.h b/ext/soap/php_soap.h
index ea1163ff..b1914e19 100644
--- a/ext/soap/php_soap.h
+++ b/ext/soap/php_soap.h
@@ -153,6 +153,8 @@ struct _soapService {
 #define SOAP_SSL_METHOD_SSLv3   2
 #define SOAP_SSL_METHOD_SSLv23  3
 
+#define SOAP_MAX_XML_DEPTH 2048
+#define SOAP_MAX_DECODE_DEPTH (SOAP_MAX_XML_DEPTH * 2)
 
 ZEND_BEGIN_MODULE_GLOBALS(soap)
 	HashTable  defEncNs;     /* mapping of default namespaces to prefixes */
