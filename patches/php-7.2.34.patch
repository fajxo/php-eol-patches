+++ b/ext/standard/ftp_fopen_wrapper.c
@@ -148,7 +148,7 @@ static php_stream *php_ftp_fopen_connect(php_stream_wrapper *wrapper, const char
 		return NULL;
 	}
 
-	use_ssl = resource->scheme && (strlen(resource->scheme) > 3) && resource->scheme[3] == 's';
+	use_ssl = resource->scheme && strcasecmp(resource->scheme, "ftps") == 0;
 
 	/* use port 21 if one wasn't specified */
 	if (resource->port == 0)
