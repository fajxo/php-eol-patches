From a977be8f7ba0de402558dbba149048eac64d03b9 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Thu, 19 Nov 2026 16:52:24 +0100
Subject: [PATCH 09/11] Fix GHSA-fm2m-fjf5-v3cp (CVE-2026-126714): RCE via
 corrupted session file

ps_files_write() truncated the session file only when the new data was
shorter than the old file. If the write was interrupted, the remainder
of the previous session data could follow the partial new data, and the
concatenation could be unserialized as attacker-influenced session data.

Backport of php-src e2d3cee9ad to 7.2.34: always ftruncate() the file
before writing and fail the write (with a warning) if that fails. The
code is identical in 7.2 except for the int (not zend_result) return
type of ps_files_write().

No upstream test exists for this fix.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ext/session/mod_files.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/ext/session/mod_files.c b/ext/session/mod_files.c
index b313d8bb..69f30ff7 100644
--- a/ext/session/mod_files.c
+++ b/ext/session/mod_files.c
@@ -240,9 +240,9 @@ static int ps_files_write(ps_files *data, zend_string *key, zend_string *val)
 		return FAILURE;
 	}
 
-	/* Truncate file if the amount of new data is smaller than the existing data set. */
-	if (ZSTR_LEN(val) < data->st_size) {
-		php_ignore_value(ftruncate(data->fd, 0));
+	if (ftruncate(data->fd, 0) != 0) {
+		php_error_docref(NULL, E_WARNING, "ftruncate() failed: %s (%d)", strerror(errno), errno);
+		return FAILURE;
 	}
 
 #if defined(HAVE_PWRITE)
From bb5e476242e0e35d17fd94c9b754c8be8d53d0fa Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Thu, 19 Nov 2026 16:53:21 +0100
Subject: [PATCH 10/11] Fix GHSA-68fq-fh7h-f8gr (CVE-2026-128090): refuse
 keyless phar signature when .pubkey exists

The signature type is not covered by the signature itself, so an
OpenSSL signed phar (with its <phar>.pubkey next to it) could be
downgraded to a keyless hash signature (e.g. SHA-256) recomputed by an
attacker over modified content, and it was accepted.

Backport of php-src db90b7ba0d to 7.2.34: phar_verify_signature() now
fails for every non-OpenSSL signature type when "<fname>.pubkey" exists.
7.2 only has PHAR_SIG_OPENSSL (no PHAR_SIG_OPENSSL_SHA256/_SHA512), so
the condition is just sig_type != PHAR_SIG_OPENSSL; bool -> zend_bool.

Test ghsa-68fq-fh7h-f8gr.phpt: --EXTENSIONS-- replaced by SKIPIF checks
(phar, openssl, hash); otherwise unchanged (uses files/private.pem and
files/openssl.cnf, both present in 7.2).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ext/phar/tests/ghsa-68fq-fh7h-f8gr.phpt | 122 ++++++++++++++++++++++++
 ext/phar/util.c                         |  17 ++++
 2 files changed, 139 insertions(+)
 create mode 100644 ext/phar/tests/ghsa-68fq-fh7h-f8gr.phpt

diff --git a/ext/phar/tests/ghsa-68fq-fh7h-f8gr.phpt b/ext/phar/tests/ghsa-68fq-fh7h-f8gr.phpt
new file mode 100644
index 00000000..168bc4f7
--- /dev/null
+++ b/ext/phar/tests/ghsa-68fq-fh7h-f8gr.phpt
@@ -0,0 +1,122 @@
+--TEST--
+GHSA-68fq-fh7h-f8gr (OpenSSL signature bypass by downgrading the algorithm to a keyless one)
+--SKIPIF--
+<?php
+if (!extension_loaded('phar')) die('skip phar extension not available');
+if (!extension_loaded('openssl')) die('skip openssl extension not available');
+if (!extension_loaded('hash')) die('skip hash extension not available');
+if (!in_array("OpenSSL", Phar::getSupportedSignatures())) die("skip openssl support required");
+?>
+--INI--
+phar.readonly=0
+phar.require_hash=1
+--FILE--
+<?php
+$base = __DIR__ . '/' . basename(__FILE__, '.php');
+$private = openssl_pkey_get_private(file_get_contents(__DIR__ . '/files/private.pem'));
+$pkey = '';
+openssl_pkey_export($private, $pkey, null, ['config' => __DIR__ . '/files/openssl.cnf']);
+$pubkey = openssl_pkey_get_details($private)['key'];
+
+function build(string $file, string $pkey): string
+{
+    $phar = new Phar($file);
+    $phar['main.php'] = '<?php echo "GENUINE\n";';
+    $phar->setStub('<?php __HALT_COMPILER();');
+    $phar->setSignatureAlgorithm(Phar::OPENSSL, $pkey);
+
+    return file_get_contents($file);
+}
+
+// a phar built in this process comes back from the cache, so each case is read under its own name
+function open(string $file, string $archive, ?string $pubkey): void
+{
+    file_put_contents($file, $archive);
+    if ($pubkey !== null) {
+        file_put_contents($file . '.pubkey', $pubkey);
+    }
+
+    try {
+        echo (new Phar($file))->getSignature()['hash_type'], "\n";
+    } catch (UnexpectedValueException $e) {
+        echo $e->getMessage(), "\n";
+    }
+}
+
+function downgrade_phar(string $archive): string
+{
+    // the last 12 bytes are [length][algorithm]["GBMB"], the signature sits just before them
+    $siglen = unpack('V', substr($archive, -12, 4))[1];
+    $message = substr($archive, 0, strlen($archive) - 12 - $siglen);
+
+    return $message . hash('sha256', $message, true) . pack('V', 0x0003) . 'GBMB'; // 0x0003 is PHAR_SIG_SHA256
+}
+
+function downgrade_tar(string $archive): string
+{
+    for ($offset = 0; $offset + 512 <= strlen($archive); ) {
+        $size = (int) octdec(trim(substr($archive, $offset + 124, 12), " \0")); // octal size field of a 512 byte header
+
+        if (rtrim(substr($archive, $offset, 100), "\0") === '.phar/signature.bin') {
+            // the signed message stops at this header, so rewriting the entry content leaves it alone
+            $blob = pack('VV', 0x0003, 32) . hash('sha256', substr($archive, 0, $offset), true); // [algorithm][digest length][digest]
+
+            return substr_replace($archive, str_pad($blob, $size, "\0"), $offset + 512, $size);
+        }
+
+        $offset += 512 + (($size + 511) & ~511);
+    }
+
+    throw new RuntimeException('no signature entry');
+}
+
+function downgrade_zip(string $archive): string
+{
+    $eocd = strrpos($archive, "PK\x05\x06");
+    $cdir = unpack('V', substr($archive, $eocd + 16, 4))[1]; // the eocd holds the directory offset at +16 and the archive comment length at +20
+    $comment = substr($archive, $eocd + 22, unpack('v', substr($archive, $eocd + 20, 2))[1]);
+
+    for ($record = $cdir; substr($archive, $record, 4) === "PK\x01\x02"; ) {
+        $namelen = unpack('v', substr($archive, $record + 28, 2))[1];
+
+        if (substr($archive, $record + 46, $namelen) === '.phar/signature.bin') {
+            $size = unpack('V', substr($archive, $record + 24, 4))[1];
+            $local = unpack('V', substr($archive, $record + 42, 4))[1];
+            $content = $local + 30 + unpack('v', substr($archive, $local + 26, 2))[1] + unpack('v', substr($archive, $local + 28, 2))[1];
+            // the signed message is everything before the local entry plus the directory up to this record
+            $message = substr($archive, 0, $local) . substr($archive, $cdir, $record - $cdir) . $comment;
+            $blob = pack('VV', 0x0003, 32) . hash('sha256', $message, true);
+
+            return substr_replace($archive, str_pad($blob, $size, "\0"), $content, $size);
+        }
+
+        $record += 46 + $namelen + unpack('v', substr($archive, $record + 30, 2))[1] + unpack('v', substr($archive, $record + 32, 2))[1];
+    }
+
+    throw new RuntimeException('no signature entry');
+}
+
+foreach (['phar' => 'downgrade_phar', 'phar.tar' => 'downgrade_tar', 'phar.zip' => 'downgrade_zip'] as $suffix => $downgrade) {
+    $archive = build($base . '.source.' . $suffix, $pkey);
+    open($base . '.signed.' . $suffix, $archive, $pubkey);
+    open($base . '.tampered.' . $suffix, $downgrade($archive), $pubkey);
+    open($base . '.nokey.' . $suffix, $downgrade($archive), null);
+}
+?>
+--CLEAN--
+<?php
+$base = __DIR__ . '/' . basename(__FILE__, '.clean.php');
+foreach (glob($base . '.*.phar*') as $file) {
+    unlink($file);
+}
+?>
+--EXPECTF--
+OpenSSL
+phar "%stampered.phar" SHA256 signature could not be verified: openssl public key found, but the signature does not use openssl
+SHA-256
+OpenSSL
+phar error: tar-based phar "%stampered.phar.tar" signature cannot be verified: openssl public key found, but the signature does not use openssl
+SHA-256
+OpenSSL
+phar error: signature cannot be verified: openssl public key found, but the signature does not use openssl in zip-based phar "%stampered.phar.zip"
+SHA-256
diff --git a/ext/phar/util.c b/ext/phar/util.c
index 48d5a256..730ebe2d 100644
--- a/ext/phar/util.c
+++ b/ext/phar/util.c
@@ -1481,6 +1481,23 @@ int phar_verify_signature(php_stream *fp, size_t end_of_phar, uint32_t sig_type,
 
 	php_stream_rewind(fp);
 
+	if (sig_type != PHAR_SIG_OPENSSL) {
+		php_stream_statbuf ssb;
+		char *pfile;
+		zend_bool has_pubkey;
+
+		spprintf(&pfile, 0, "%s.pubkey", fname);
+		has_pubkey = php_stream_stat_path_ex(pfile, PHP_STREAM_URL_STAT_QUIET, &ssb, NULL) == 0;
+		efree(pfile);
+
+		if (has_pubkey) {
+			if (error) {
+				spprintf(error, 0, "openssl public key found, but the signature does not use openssl");
+			}
+			return FAILURE;
+		}
+	}
+
 	switch (sig_type) {
 		case PHAR_SIG_OPENSSL: {
 #ifdef PHAR_HAVE_OPENSSL
From 57070f905a060a9fca95aedf872df87a5841df54 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Thu, 19 Nov 2026 16:53:51 +0100
Subject: [PATCH 11/11] Fix GHSA-5j3f-64r7-f564 (CVE-2026-129538): PATH_INFO
 underflow in CGI init_request_info()

With cgi.fix_pathinfo=1, when the suffix stripped from SCRIPT_FILENAME
(or PATH_TRANSLATED) was longer than PATH_INFO, the re-derived PATH_INFO
pointer pointed before the start of the value and was then read,
written (a NUL byte) and copied from.

Backport of php-src 1e109bfbd2 to 7.2.34: only rewrite PATH_INFO when it
is longer than the stripped suffix, as FPM has done since the
CVE-2019-11043 fix (fpm_main.c already has that check and is left
untouched). init_request_info() is otherwise identical to 8.2.

Test ghsa-5j3f-64r7-f564.phpt: proc_open() takes a command string
(escapeshellarg) instead of an argv array, which 7.2 does not support.

