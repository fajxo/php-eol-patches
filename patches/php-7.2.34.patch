From 05ec9ff28a8e11432c32951bae067ceafaa8b470 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Wed, 25 Nov 2026 18:34:20 +0100
Subject: [PATCH] ext/soap: fix SOAP bailout handling

SoapClient::__call() reused the _bailout variable of
SOAP_CLIENT_BEGIN/END_CODE() after setjmp(). It is not volatile, so
reading it back after a longjmp is undefined; built with GCC 14 and
later, a SoapFault raised for an error in __call() cannot be caught and
ends the script with "Uncaught SoapFault exception"
(ext/soap/tests/bugs/bug66112.phpt). Use a separate local
variable instead, as upstream does.

Backport of php-src 4f28bbda51 (Nikita Popov), Sury's 7.2 patch 0252.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ext/soap/soap.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/ext/soap/soap.c b/ext/soap/soap.c
index 7b188f3a..78221286 100644
--- a/ext/soap/soap.c
+++ b/ext/soap/soap.c
@@ -2624,6 +2624,7 @@ static void do_soap_call(zend_execute_data *execute_data,
 	int old_features;
 	HashTable *old_typemap, *typemap = NULL;
 	smart_str action = {0};
+	int bailout = 0;
 
 	SOAP_CLIENT_BEGIN_CODE();
 
@@ -2790,7 +2791,7 @@ static void do_soap_call(zend_execute_data *execute_data,
 		}
 
 	} zend_catch {
-		_bailout = 1;
+		bailout = 1;
 	} zend_end_try();
 
 	if (SOAP_GLOBAL(encoding) != NULL) {
@@ -2802,12 +2803,11 @@ static void do_soap_call(zend_execute_data *execute_data,
 	SOAP_GLOBAL(class_map) = old_class_map;
 	SOAP_GLOBAL(encoding) = old_encoding;
 	SOAP_GLOBAL(sdl) = old_sdl;
-	if (_bailout) {
+	if (bailout) {
 		smart_str_free(&action);
 		if (request) {
 			xmlFreeDoc(request);
 		}
-		_bailout = 0;
 		zend_bailout();
 	}
 	SOAP_CLIENT_END_CODE();
From 297800c836a4082f9d5c77a36b925a18dbfe11ac Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Wed, 25 Nov 2026 18:34:20 +0100
Subject: [PATCH] gd: add the bug #81739 (CVE-2022-31630) imageloadfont() test

7.4.33 fixed an out-of-bounds read in imageloadfont(): 7.4 checked the
font header for overflow before swapping its byte order, not after.
7.2 has the check after the swap, so the byte-swapped header is already
rejected and there is nothing to fix. Add upstream's test (with an
expectation that does not depend on the gd warning text) so that stays
proven.

Test from php-src d50532be91 (Christoph M. Becker).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ext/gd/tests/bug81739.phpt | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)
 create mode 100644 ext/gd/tests/bug81739.phpt

diff --git a/ext/gd/tests/bug81739.phpt b/ext/gd/tests/bug81739.phpt
new file mode 100644
index 00000000..6bba26b3
--- /dev/null
+++ b/ext/gd/tests/bug81739.phpt
@@ -0,0 +1,21 @@
+--TEST--
+Bug #81739 (OOB read due to insufficient validation in imageloadfont())
+--SKIPIF--
+<?php
+if (!extension_loaded("gd")) die("skip gd extension not available");
+?>
+--FILE--
+<?php
+$s = fopen(__DIR__ . "/font.font", "w");
+// header without character data
+fwrite($s, "\x01\x00\x00\x00\x20\x00\x00\x00\x08\x00\x00\x00\x08\x00\x00\x00");
+fclose($s);
+var_dump(imageloadfont(__DIR__ . "/font.font"));
+?>
+--CLEAN--
+<?php
+@unlink(__DIR__ . "/font.font");
+?>
+--EXPECTF--
+%AWarning: imageloadfont(): Error reading font, invalid font header in %s on line %d
+bool(false)
From cfc9cff5aa7228217b1aa49c3f65270e9f2a4fb2 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Wed, 25 Nov 2026 18:34:20 +0100
Subject: [PATCH] http wrapper: free the dechunk filter and a repeated Location

Two request-scoped leaks in the http:// wrapper, found while porting
the 2026-11-25 fixes to 5.6 (which has both fixes):

- When the request fails after a Transfer-Encoding: chunked header was
  seen (the stream is closed and NULL at out:), the dechunk filter was
  never freed. Only the redirect path freed it.
- A Location header after an empty one allocated a new buffer, because
  "no location yet" was tested with location_len == 0, and the first
  buffer leaked. Test the pointer instead.

Both are emalloc memory freed at request end, so not a security issue;
upstream has the same code.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ext/standard/http_fopen_wrapper.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/ext/standard/http_fopen_wrapper.c b/ext/standard/http_fopen_wrapper.c
index e884e99f..4037ac0e 100644
--- a/ext/standard/http_fopen_wrapper.c
+++ b/ext/standard/http_fopen_wrapper.c
@@ -305,7 +305,7 @@ static zend_bool php_stream_http_response_headers_parse(php_stream_wrapper *wrap
 			zend_string_efree(last_header_line_str);
 			return 0;
 		}
-		if (header_info->location_len == 0) {
+		if (header_info->location == NULL) {
 			header_info->location = emalloc(last_header_value_len + 1);
 		} else if (header_info->location_len <= last_header_value_len) {
 			header_info->location = erealloc(header_info->location, last_header_value_len + 1);
@@ -1214,6 +1214,8 @@ out:
 		if (header_info.transfer_encoding) {
 			php_stream_filter_append(&stream->readfilters, header_info.transfer_encoding);
 		}
+	} else if (header_info.transfer_encoding) {
+		php_stream_filter_free(header_info.transfer_encoding);
 	}
 
 	return stream;
