Date: Thu, 19 Nov 2026 16:49:26 +0100
Subject: [PATCH] Fix GHSA-gr4f-wgx5-jpfv (CVE-2026-129496): DATEG(tzcache)
 use-after-free

A diagnostic written to a file error_log during module startup formatted
its timestamp in the configured timezone, which allocated DATEG(tzcache)
in startup memory. That memory is released at the end of startup but the
pointer stays until the date extension's RINIT, so an early request
diagnostic (e.g. max_input_vars exceeded) could use the freed hash.

Backport of php-src cb20015e04 to 7.2.34: php_log_err() formats the
timestamp in local time only when PG(modules_activated) && EG(active),
i.e. inside a fully initialized active request, and in UTC otherwise.
The ZTS/non-ZTS split is replaced by this single call as upstream did.

The zend_test parts (zend_test.warn_on_startup) are not ported. The test
uses track_errors=1 instead, which in 7.2 emits an E_DEPRECATED at the
end of php_module_startup(), before the startup heap is released, and
checks that both log lines are written in UTC.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ext/date/tests/GHSA-gr4f-wgx5-jpfv.phpt | 31 +++++++++++++++++++++++++
 main/main.c                             | 10 +-------
 2 files changed, 32 insertions(+), 9 deletions(-)
 create mode 100644 ext/date/tests/GHSA-gr4f-wgx5-jpfv.phpt

diff --git a/ext/date/tests/GHSA-gr4f-wgx5-jpfv.phpt b/ext/date/tests/GHSA-gr4f-wgx5-jpfv.phpt
new file mode 100644
index 00000000..a495fd92
--- /dev/null
+++ b/ext/date/tests/GHSA-gr4f-wgx5-jpfv.phpt
@@ -0,0 +1,31 @@
+--TEST--
+GHSA-gr4f-wgx5-jpfv: DATEG(tzcache) use-after-free
+--CREDITS--
+Sebastian Bergmann
+--INI--
+error_log="{TMP}/GHSA-gr4f-wgx5-jpfv.log"
+log_errors=1
+display_startup_errors=0
+max_input_vars=1
+date.timezone=America/New_York
+track_errors=1
+--GET--
+a=1&b=2
+--FILE--
+<?php
+echo "Hello world\n";
+/* the startup deprecation (track_errors) and the request startup warning
+ * must both be logged in UTC, without touching DATEG(tzcache); neither is
+ * displayed (display_startup_errors=0 hides request startup errors too) */
+$log = file_get_contents(ini_get('error_log'));
+var_dump(preg_match_all('/^\[\d{2}-\w{3}-\d{4} \d{2}:\d{2}:\d{2} UTC\] PHP (Deprecated|Warning): /m', $log));
+var_dump(substr_count($log, 'America/New_York]'));
+?>
+--CLEAN--
+<?php
+@unlink(sys_get_temp_dir() . '/GHSA-gr4f-wgx5-jpfv.log');
+?>
+--EXPECTF--
+%AHello world
+int(2)
+int(0)%A
diff --git a/main/main.c b/main/main.c
index 92c19e46..987f45ab 100644
--- a/main/main.c
+++ b/main/main.c
@@ -696,15 +696,7 @@ PHPAPI ZEND_COLD void php_log_err_with_severity(char *log_message, int syslog_ty
 			zend_string *error_time_str;
 
 			time(&error_time);
-#ifdef ZTS
-			if (!php_during_module_startup()) {
-				error_time_str = php_format_date("d-M-Y H:i:s e", 13, error_time, 1);
-			} else {
-				error_time_str = php_format_date("d-M-Y H:i:s e", 13, error_time, 0);
-			}
-#else
-			error_time_str = php_format_date("d-M-Y H:i:s e", 13, error_time, 1);
-#endif
+			error_time_str = php_format_date("d-M-Y H:i:s e", 13, error_time, PG(modules_activated) && EG(active));
 			len = spprintf(&tmp, 0, "[%s] %s%s", ZSTR_VAL(error_time_str), log_message, PHP_EOL);
 #ifdef PHP_WIN32
 			php_flock(fd, 2);
From dee06dffd404e4bf8bef48335da75171e3e00a22 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Thu, 19 Nov 2026 16:50:37 +0100
Subject: [PATCH] Fix GHSA-f6gg-rchx-xw8j (CVE-2026-128064): mixed case HTTPS
 and FTPS

The HTTP and FTP wrappers decided whether to use TLS by looking at a
single lowercase 's' at a fixed position of the scheme, so URLs such as
HTTPS://... or FTPS://... (the wrapper lookup is case-insensitive) were
sent in plaintext, including credentials and request bodies.

Backport of php-src 9c0b44ffd6 to 7.2.34: in 7.2 php_url.scheme is a
char *, not a zend_string, so zend_string_equals_literal_ci() is
replaced by strcasecmp(resource->scheme, "https"/"ftps") == 0; the
resource->scheme NULL guard is kept in both wrappers.

The tests are rewritten without the 8.x ServerClientTestCase message
passing (phpt_notify_server_start()/phpt_notify(message:) do not exist
in 7.2): the server runs in a child `php -n -r` process started with
proc_open(), prints its address and the result on stdout.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ext/standard/ftp_fopen_wrapper.c              |  2 +-
 ext/standard/http_fopen_wrapper.c             |  2 +-
 .../tests/http/ghsa-f6gg-rchx-xw8j.phpt       | 67 +++++++++++++++++++
 .../tests/streams/ghsa-f6gg-rchx-xw8j.phpt    | 40 +++++++++++
 4 files changed, 109 insertions(+), 2 deletions(-)
 create mode 100644 ext/standard/tests/http/ghsa-f6gg-rchx-xw8j.phpt
 create mode 100644 ext/standard/tests/streams/ghsa-f6gg-rchx-xw8j.phpt

diff --git a/ext/standard/ftp_fopen_wrapper.c b/ext/standard/ftp_fopen_wrapper.c
index e23ffee1..331b2e80 100644
--- a/ext/standard/ftp_fopen_wrapper.c
+++ b/ext/standard/ftp_fopen_wrapper.c
@@ -148,7 +148,7 @@ static php_stream *php_ftp_fopen_connect(php_stream_wrapper *wrapper, const char
 		return NULL;
 	}
 
-	use_ssl = resource->scheme && (strlen(resource->scheme) > 3) && resource->scheme[3] == 's';
+	use_ssl = resource->scheme && strcasecmp(resource->scheme, "ftps") == 0;
 
 	/* use port 21 if one wasn't specified */
 	if (resource->port == 0)
diff --git a/ext/standard/http_fopen_wrapper.c b/ext/standard/http_fopen_wrapper.c
index be23679d..8c5caadf 100644
--- a/ext/standard/http_fopen_wrapper.c
+++ b/ext/standard/http_fopen_wrapper.c
@@ -176,7 +176,7 @@ static php_stream *php_stream_url_wrap_http_ex(php_stream_wrapper *wrapper,
 			return NULL;
 		}
 
-		use_ssl = resource->scheme && (strlen(resource->scheme) > 4) && resource->scheme[4] == 's';
+		use_ssl = resource->scheme && strcasecmp(resource->scheme, "https") == 0;
 		/* choose default ports */
 		if (use_ssl && resource->port == 0)
 			resource->port = 443;
diff --git a/ext/standard/tests/http/ghsa-f6gg-rchx-xw8j.phpt b/ext/standard/tests/http/ghsa-f6gg-rchx-xw8j.phpt
new file mode 100644
index 00000000..9986ff32
--- /dev/null
+++ b/ext/standard/tests/http/ghsa-f6gg-rchx-xw8j.phpt
@@ -0,0 +1,67 @@
+--TEST--
+GHSA-f6gg-rchx-xw8j: mixed-case HTTPS URLs must use TLS
+--SKIPIF--
+<?php
+if (!extension_loaded('openssl')) die('skip openssl extension not available');
+if (!function_exists('proc_open')) die('skip proc_open() not available');
+?>
+--INI--
+default_socket_timeout=5
+--FILE--
+<?php
+$serverCode = <<<'CODE'
+$server = stream_socket_server('tcp://127.0.0.1:0', $errno, $errstr);
+if (!$server) {
+    echo "server error: $errstr\n";
+    exit(1);
+}
+echo stream_socket_get_name($server, false), "\n";
+$conn = stream_socket_accept($server, 10);
+if (!$conn) {
+    echo "no connection\n";
+    exit(1);
+}
+$request = fread($conn, 1);
+if ($request === "\x16") {
+    echo "TLS\n";
+} else {
+    while (($line = stream_get_line($conn, 8192, "\r\n")) !== false) {
+        $request .= $line . "\r\n";
+        if ($line === '') {
+            break;
+        }
+    }
+    $request .= stream_get_contents($conn, strlen('opensec-sensitive-body'));
+    echo strpos($request, 'Authorization: Basic ') !== false
+        && strpos($request, 'X-Opensec-Request: validation') !== false
+        && strpos($request, 'opensec-sensitive-body') !== false
+            ? "plaintext credentials and body\n"
+            : "unexpected plaintext request\n";
+}
+fclose($conn);
+fclose($server);
+CODE;
+
+$proc = proc_open(escapeshellarg(PHP_BINARY) . ' -n -r ' . escapeshellarg($serverCode), [1 => ['pipe', 'w']], $pipes);
+$addr = trim(fgets($pipes[1]));
+
+$context = stream_context_create([
+    'http' => [
+        'method' => 'POST',
+        'content' => 'opensec-sensitive-body',
+        'header' => "X-Opensec-Request: validation\r\n",
+        'timeout' => 5,
+    ],
+    'ssl' => [
+        'verify_peer' => false,
+        'verify_peer_name' => false,
+    ],
+]);
+var_dump(@file_get_contents("HTTPS://alice:secret@$addr/secret", false, $context));
+echo stream_get_contents($pipes[1]);
+fclose($pipes[1]);
+proc_close($proc);
+?>
+--EXPECT--
+bool(false)
+TLS
