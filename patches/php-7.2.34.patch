 main/SAPI.c                                   |   3 +-
 main/fastcgi.c                                |   6 +
 sapi/fpm/tests/unread-body-keep-conn.phpt     | 125 +++++++++++++++++
 .../fpm/tests/unread-body-partial-record.phpt | 127 ++++++++++++++++++
