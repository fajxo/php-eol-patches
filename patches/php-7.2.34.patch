+  <SOAP-ENV:Body>
+    <ns1:test><param0>x</param0></ns1:test>
+  </SOAP-ENV:Body>
+</SOAP-ENV:Envelope>
+--SKIPIF--
+<?php require_once('skipif.inc'); ?>
+--FILE--
+<?php
+function test($x) {
+    return $x;
+}
+
+$server = new SoapServer(null, ['uri' => 'urn:test']);
