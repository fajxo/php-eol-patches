From 7e70261081773aca20e4e180eb45e28a8d2b1011 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Sun, 8 Nov 2026 09:20:46 +0100
Subject: [PATCH 02/11] Build against OpenSSL 4.x (keeps 1.1-3.x working)

OpenSSL 4.0 (and 4.1, API-compatible) removed APIs that ext/openssl
still used, so the build failed against dev-libs/openssl-4.1.0:

- ASN1_STRING is opaque and ASN1_STRING_data() is gone: use
  ASN1_STRING_get0_data()/ASN1_STRING_length() (old macro for < 1.1).
- OPENSSL_NO_SSL3 is no longer defined because SSLv3 was removed
  entirely; define it for >= 4.0 so SSLv3 stays "unavailable" as with
  1.1-3.x builds (otherwise the sslv3:// transport is registered).
- ERR_NUM_ERRORS is no longer exported; it only sizes PHP's own error
  ring buffer, keep the 1.0-3.x value 16.

Tested in a throwaway build container (gcc 16, Arch Linux): builds against OpenSSL 4.1.0 and
3.6.5; TLS smoke (tls/tlsv1.2 wrappers, pinned TLSv1_2 client and
server refusing 1.3, IP SAN peer_name, x509_parse) identical on both;
phpt ext/openssl+ftp+phar: patched vs 4.1 and patched vs 3.6 fail no
test that orig vs 3.6 passes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ext/openssl/openssl.c     | 16 +++++++++++-----
 ext/openssl/php_openssl.h |  6 ++++++
 ext/openssl/xp_ssl.c      | 23 ++++++++++++++++++-----
 3 files changed, 35 insertions(+), 10 deletions(-)

diff --git a/ext/openssl/openssl.c b/ext/openssl/openssl.c
index 9866bf5d..a146dfae 100644
--- a/ext/openssl/openssl.c
+++ b/ext/openssl/openssl.c
@@ -56,6 +56,12 @@
 #include <openssl/ssl.h>
 #include <openssl/pkcs12.h>
 
+/* OpenSSL 4.0 removed SSLv3 completely and no longer defines OPENSSL_NO_SSL3.
+ * Define it so SSLv3 is reported as unavailable, as with 1.1-3.x builds. */
+#if OPENSSL_VERSION_NUMBER >= 0x40000000L && !defined(LIBRESSL_VERSION_NUMBER) && !defined(OPENSSL_NO_SSL3)
+# define OPENSSL_NO_SSL3
+#endif
+
 /* Common */
 #include <time.h>
 
@@ -943,7 +949,7 @@ static void php_openssl_add_assoc_name_entry(zval * val, char * key, X509_NAME *
 
 static void php_openssl_add_assoc_asn1_string(zval * val, char * key, ASN1_STRING * str) /* {{{ */
 {
-	add_assoc_stringl(val, key, (char *)str->data, str->length);
+	add_assoc_stringl(val, key, (char *)ASN1_STRING_get0_data(str), ASN1_STRING_length(str));
 }
 /* }}} */
 
@@ -976,12 +982,12 @@ static time_t php_openssl_asn1_time_to_time_t(ASN1_UTCTIME * timestr) /* {{{ */
 	}
 
 	if (timestr_len < 13 && timestr_len != 11) {
-		php_error_docref(NULL, E_WARNING, "unable to parse time string %s correctly", timestr->data);
+		php_error_docref(NULL, E_WARNING, "unable to parse time string %s correctly", (const char *)ASN1_STRING_get0_data(timestr));
 		return (time_t)-1;
 	}
 
 	if (ASN1_STRING_type(timestr) == V_ASN1_GENERALIZEDTIME && timestr_len < 15) {
-		php_error_docref(NULL, E_WARNING, "unable to parse time string %s correctly", timestr->data);
+		php_error_docref(NULL, E_WARNING, "unable to parse time string %s correctly", (const char *)ASN1_STRING_get0_data(timestr));
 		return (time_t)-1;
 	}
 
@@ -2305,8 +2311,8 @@ static int openssl_x509v3_subjectAltName(BIO *bio, X509_EXTENSION *extension)
 	}
 
 	extension_data = X509_EXTENSION_get_data(extension);
-	p = extension_data->data;
-	length = extension_data->length;
+	p = ASN1_STRING_get0_data(extension_data);
+	length = ASN1_STRING_length(extension_data);
 	if (method->it) {
 		names = (GENERAL_NAMES*) (ASN1_item_d2i(NULL, &p, length,
 			ASN1_ITEM_ptr(method->it)));
diff --git a/ext/openssl/php_openssl.h b/ext/openssl/php_openssl.h
index 7926b475..9d0138a0 100644
--- a/ext/openssl/php_openssl.h
+++ b/ext/openssl/php_openssl.h
@@ -66,6 +66,12 @@ extern zend_module_entry openssl_module_entry;
 
 #include <openssl/err.h>
 
+/* OpenSSL 4.0 no longer exports ERR_NUM_ERRORS. It only sizes PHP's own error
+ * ring buffer here; keep the 1.0-3.x value. */
+#ifndef ERR_NUM_ERRORS
+# define ERR_NUM_ERRORS 16
+#endif
+
 #ifdef PHP_WIN32
 #	define PHP_OPENSSL_API __declspec(dllexport)
 #elif defined(__GNUC__) && __GNUC__ >= 4
diff --git a/ext/openssl/xp_ssl.c b/ext/openssl/xp_ssl.c
index 9710e44a..b7ed25e9 100644
--- a/ext/openssl/xp_ssl.c
+++ b/ext/openssl/xp_ssl.c
@@ -36,6 +36,19 @@
 #include <openssl/x509v3.h>
 #include <openssl/err.h>
 
+/* OpenSSL 4.0 removed SSLv3 completely and no longer defines OPENSSL_NO_SSL3.
+ * Define it so SSLv3 is reported as unavailable, as with 1.1-3.x builds. */
+#if OPENSSL_VERSION_NUMBER >= 0x40000000L && !defined(LIBRESSL_VERSION_NUMBER) && !defined(OPENSSL_NO_SSL3)
+# define OPENSSL_NO_SSL3
+#endif
+
+/* OpenSSL 4.0 made ASN1_STRING opaque and removed ASN1_STRING_data() */
+#if OPENSSL_VERSION_NUMBER < 0x10100000L || (defined(LIBRESSL_VERSION_NUMBER) && LIBRESSL_VERSION_NUMBER < 0x2070000fL)
+# define PHP_OPENSSL_ASN1_DATA(s) ASN1_STRING_data(s)
+#else
+# define PHP_OPENSSL_ASN1_DATA(s) ASN1_STRING_get0_data(s)
+#endif
+
 #if OPENSSL_VERSION_NUMBER >= 0x10002000L
 #include <openssl/bn.h>
 #include <openssl/dh.h>
@@ -455,12 +468,12 @@ static zend_bool php_openssl_matches_san_list(X509 *peer, const char *subject_na
 			}
 			OPENSSL_free(cert_name);
 		} else if (san->type == GEN_IPADD) {
-			if (san->d.iPAddress->length == 4) {
+			if (ASN1_STRING_length(san->d.iPAddress) == 4) {
 				sprintf(ipbuffer, "%d.%d.%d.%d",
-					san->d.iPAddress->data[0],
-					san->d.iPAddress->data[1],
-					san->d.iPAddress->data[2],
-					san->d.iPAddress->data[3]
+					PHP_OPENSSL_ASN1_DATA(san->d.iPAddress)[0],
+					PHP_OPENSSL_ASN1_DATA(san->d.iPAddress)[1],
+					PHP_OPENSSL_ASN1_DATA(san->d.iPAddress)[2],
+					PHP_OPENSSL_ASN1_DATA(san->d.iPAddress)[3]
 				);
 				if (strcasecmp(subject_name, (const char*)ipbuffer) == 0) {
 					sk_GENERAL_NAME_pop_free(alt_names, GENERAL_NAME_free);
