From 14f703fada5300076859b609f8336b76a5c5feb6 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Wed, 25 Nov 2026 18:34:22 +0100
Subject: [PATCH] Fix bug #79330: shell_exec() and friends NUL truncation

shell_exec() and the backtick operator accepted a command with a NUL
byte and ran the part before it; exec(), system() and passthru()
already refused it. shell_exec() now rejects NUL and empty commands too.

Backport of php-src 14fcc81394 (Stanislav Malyshev), Sury's 5.6 patch
0139.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ext/standard/exec.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/ext/standard/exec.c b/ext/standard/exec.c
index 88a6b4ab..a586b786 100644
--- a/ext/standard/exec.c
+++ b/ext/standard/exec.c
@@ -537,6 +537,15 @@ PHP_FUNCTION(shell_exec)
 		return;
 	}
 
+	if (!command_len) {
+		php_error_docref(NULL, E_WARNING, "Cannot execute a blank command");
+		RETURN_FALSE;
+	}
+	if (strlen(command) != command_len) {
+		php_error_docref(NULL, E_WARNING, "NULL byte detected. Possible attack");
+		RETURN_FALSE;
+	}
+
 #ifdef PHP_WIN32
 	if ((in=VCWD_POPEN(command, "rt"))==NULL) {
 #else
