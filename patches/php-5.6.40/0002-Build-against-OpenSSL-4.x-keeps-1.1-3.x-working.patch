From 88548154b115015ac7bbbfa9b29de6e018acd031 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Sun, 8 Nov 2026 09:20:45 +0100
Subject: [PATCH] Build against OpenSSL 4.x (keeps 1.1-3.x working)

OpenSSL 4.0 (and 4.1, API-compatible) removed APIs that ext/openssl
still used, so the build failed against dev-libs/openssl-4.1.0:

- ASN1_STRING is opaque and ASN1_STRING_data() is gone: use
  ASN1_STRING_get0_data()/ASN1_STRING_length() (old macro for < 1.1).
- OPENSSL_NO_SSL3 is no longer defined because SSLv3 was removed
  entirely; define it for >= 4.0 so SSLv3 stays "unavailable" as with
  1.1-3.x builds (otherwise the sslv3:// transport is registered).
- SSLv3/TLSv1/TLSv1_1/TLSv1_2_{client,server}_method() are removed.
  Since 1.1.0 they were TLS_method() pinned to one version, so
  php_select_crypto_method() returns TLS_{client,server}_method() and
  php_openssl_setup_crypto() pins min = max protocol version.
- add_assoc_name_entry(): free the ASN1_STRING_to_UTF8() buffer (leak).

Tested in a throwaway build container (gcc 16, Arch Linux): builds against OpenSSL 4.1.0 and
3.6.5; TLS smoke (tls/tlsv1.2 wrappers, pinned TLSv1_2 client and
server refusing 1.3, IP SAN peer_name, x509_parse) identical on both;
phpt ext/openssl+ftp+phar: patched vs 4.1 and patched vs 3.6 fail no
test that orig vs 3.6 passes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ext/openssl/openssl.c | 46 ++++++++++++++++++--------
 ext/openssl/xp_ssl.c  | 77 ++++++++++++++++++++++++++++++++++++++-----
 2 files changed, 100 insertions(+), 23 deletions(-)

diff --git a/ext/openssl/openssl.c b/ext/openssl/openssl.c
index c53e3ec5..f73ca394 100644
--- a/ext/openssl/openssl.c
+++ b/ext/openssl/openssl.c
@@ -58,6 +58,19 @@
 #include <openssl/ssl.h>
 #include <openssl/pkcs12.h>
 
+/* OpenSSL 4.0 removed SSLv3 completely and no longer defines OPENSSL_NO_SSL3.
+ * Define it so SSLv3 is reported as unavailable, as with 1.1-3.x builds. */
+#if OPENSSL_VERSION_NUMBER >= 0x40000000L && !defined(LIBRESSL_VERSION_NUMBER) && !defined(OPENSSL_NO_SSL3)
+# define OPENSSL_NO_SSL3
+#endif
+
+/* OpenSSL 4.0 made ASN1_STRING opaque and removed ASN1_STRING_data() */
+#if OPENSSL_VERSION_NUMBER < 0x10100000L || (defined(LIBRESSL_VERSION_NUMBER) && LIBRESSL_VERSION_NUMBER < 0x2070000fL)
+# define PHP_OPENSSL_ASN1_DATA(s) ASN1_STRING_data(s)
+#else
+# define PHP_OPENSSL_ASN1_DATA(s) ASN1_STRING_get0_data(s)
+#endif
+
 /* Common */
 #include <time.h>
 
@@ -776,7 +789,8 @@ static void add_assoc_name_entry(zval * val, char * key, X509_NAME * name, int s
 	}
 	
 	for (i = 0; i < X509_NAME_entry_count(name); i++) {
-		unsigned char *to_add;
+		const unsigned char *to_add = NULL;
+		unsigned char *to_add_buf = NULL;
 		int to_add_len = 0;
 
 
@@ -792,9 +806,10 @@ static void add_assoc_name_entry(zval * val, char * key, X509_NAME * name, int s
 
 		str = X509_NAME_ENTRY_get_data(ne);
 		if (ASN1_STRING_type(str) != V_ASN1_UTF8STRING) {
-			to_add_len = ASN1_STRING_to_UTF8(&to_add, str);
+			to_add_len = ASN1_STRING_to_UTF8(&to_add_buf, str);
+			to_add = to_add_buf;
 		} else {
-			to_add = ASN1_STRING_data(str);
+			to_add = PHP_OPENSSL_ASN1_DATA(str);
 			to_add_len = ASN1_STRING_length(str);
 		}
 
@@ -814,6 +829,9 @@ static void add_assoc_name_entry(zval * val, char * key, X509_NAME * name, int s
 				add_assoc_stringl(subitem, sname, (char *)to_add, to_add_len, 1);
 			}
 		}
+		if (to_add_buf != NULL) {
+			OPENSSL_free(to_add_buf);
+		}
 	}
 	if (key != NULL) {
 		zend_hash_update(HASH_OF(val), key, strlen(key) + 1, (void *)&subitem, sizeof(subitem), NULL);
@@ -823,7 +841,7 @@ static void add_assoc_name_entry(zval * val, char * key, X509_NAME * name, int s
 
 static void add_assoc_asn1_string(zval * val, char * key, ASN1_STRING * str) /* {{{ */
 {
-	add_assoc_stringl(val, key, (char *)str->data, str->length, 1);
+	add_assoc_stringl(val, key, (char *)PHP_OPENSSL_ASN1_DATA(str), ASN1_STRING_length(str), 1);
 }
 /* }}} */
 
@@ -847,22 +865,22 @@ static time_t asn1_time_to_time_t(ASN1_UTCTIME * timestr TSRMLS_DC) /* {{{ */
 		return (time_t)-1;
 	}
 
-	if (ASN1_STRING_length(timestr) != strlen((const char*)ASN1_STRING_data(timestr))) {
+	if (ASN1_STRING_length(timestr) != strlen((const char*)PHP_OPENSSL_ASN1_DATA(timestr))) {
 		php_error_docref(NULL TSRMLS_CC, E_WARNING, "illegal length in timestamp");
 		return (time_t)-1;
 	}
 
 	if (ASN1_STRING_length(timestr) < 13) {
-		php_error_docref(NULL TSRMLS_CC, E_WARNING, "unable to parse time string %s correctly", timestr->data);
+		php_error_docref(NULL TSRMLS_CC, E_WARNING, "unable to parse time string %s correctly", (const char *)PHP_OPENSSL_ASN1_DATA(timestr));
 		return (time_t)-1;
 	}
 
 	if (ASN1_STRING_type(timestr) == V_ASN1_GENERALIZEDTIME && ASN1_STRING_length(timestr) < 15) {
-		php_error_docref(NULL TSRMLS_CC, E_WARNING, "unable to parse time string %s correctly", timestr->data);
+		php_error_docref(NULL TSRMLS_CC, E_WARNING, "unable to parse time string %s correctly", (const char *)PHP_OPENSSL_ASN1_DATA(timestr));
 		return (time_t)-1;
 	}
 
-	strbuf = estrdup((char *)ASN1_STRING_data(timestr));
+	strbuf = estrdup((char *)PHP_OPENSSL_ASN1_DATA(timestr));
 
 	memset(&thetime, 0, sizeof(thetime));
 
@@ -1872,7 +1890,7 @@ PHP_FUNCTION(openssl_spki_export_challenge)
 		goto cleanup;
 	}
 
-	RETVAL_STRING((char *) ASN1_STRING_data(spki->spkac->challenge), 1);
+	RETVAL_STRING((char *) PHP_OPENSSL_ASN1_DATA(spki->spkac->challenge), 1);
 	goto cleanup;
 
 cleanup:
@@ -2052,8 +2070,8 @@ static int openssl_x509v3_subjectAltName(BIO *bio, X509_EXTENSION *extension)
 	}
 
 	extension_data = X509_EXTENSION_get_data(extension);
-	p = extension_data->data;
-	length = extension_data->length;
+	p = PHP_OPENSSL_ASN1_DATA(extension_data);
+	length = ASN1_STRING_length(extension_data);
 	if (method->it) {
 		names = (GENERAL_NAMES*)(ASN1_item_d2i(NULL, &p, length,
 						       ASN1_ITEM_ptr(method->it)));
@@ -2073,19 +2091,19 @@ static int openssl_x509v3_subjectAltName(BIO *bio, X509_EXTENSION *extension)
 				case GEN_EMAIL:
 					BIO_puts(bio, "email:");
 					as = name->d.rfc822Name;
-					BIO_write(bio, ASN1_STRING_data(as),
+					BIO_write(bio, PHP_OPENSSL_ASN1_DATA(as),
 						  ASN1_STRING_length(as));
 					break;
 				case GEN_DNS:
 					BIO_puts(bio, "DNS:");
 					as = name->d.dNSName;
-					BIO_write(bio, ASN1_STRING_data(as),
+					BIO_write(bio, PHP_OPENSSL_ASN1_DATA(as),
 						  ASN1_STRING_length(as));
 					break;
 				case GEN_URI:
 					BIO_puts(bio, "URI:");
 					as = name->d.uniformResourceIdentifier;
-					BIO_write(bio, ASN1_STRING_data(as),
+					BIO_write(bio, PHP_OPENSSL_ASN1_DATA(as),
 						  ASN1_STRING_length(as));
 					break;
 				default:
diff --git a/ext/openssl/xp_ssl.c b/ext/openssl/xp_ssl.c
index c2d477c1..505e986e 100644
--- a/ext/openssl/xp_ssl.c
+++ b/ext/openssl/xp_ssl.c
@@ -36,6 +36,19 @@
 #include <openssl/x509v3.h>
 #include <openssl/err.h>
 
+/* OpenSSL 4.0 removed SSLv3 completely and no longer defines OPENSSL_NO_SSL3.
+ * Define it so SSLv3 is reported as unavailable, as with 1.1-3.x builds. */
+#if OPENSSL_VERSION_NUMBER >= 0x40000000L && !defined(LIBRESSL_VERSION_NUMBER) && !defined(OPENSSL_NO_SSL3)
+# define OPENSSL_NO_SSL3
+#endif
+
+/* OpenSSL 4.0 made ASN1_STRING opaque and removed ASN1_STRING_data() */
+#if OPENSSL_VERSION_NUMBER < 0x10100000L || (defined(LIBRESSL_VERSION_NUMBER) && LIBRESSL_VERSION_NUMBER < 0x2070000fL)
+# define PHP_OPENSSL_ASN1_DATA(s) ASN1_STRING_data(s)
+#else
+# define PHP_OPENSSL_ASN1_DATA(s) ASN1_STRING_get0_data(s)
+#endif
+
 #ifdef PHP_WIN32
 #include "win32/winutil.h"
 #include "win32/time.h"
@@ -402,12 +415,12 @@ static zend_bool matches_san_list(X509 *peer, const char *subject_name) /* {{{ *
 			}
 			OPENSSL_free(cert_name);
 		} else if (san->type == GEN_IPADD) {
-			if (san->d.iPAddress->length == 4) {
+			if (ASN1_STRING_length(san->d.iPAddress) == 4) {
 				sprintf(ipbuffer, "%d.%d.%d.%d",
-					san->d.iPAddress->data[0],
-					san->d.iPAddress->data[1],
-					san->d.iPAddress->data[2],
-					san->d.iPAddress->data[3]
+					PHP_OPENSSL_ASN1_DATA(san->d.iPAddress)[0],
+					PHP_OPENSSL_ASN1_DATA(san->d.iPAddress)[1],
+					PHP_OPENSSL_ASN1_DATA(san->d.iPAddress)[2],
+					PHP_OPENSSL_ASN1_DATA(san->d.iPAddress)[3]
 				);
 				if (strcasecmp(subject_name, (const char*)ipbuffer) == 0) {
 					return 1;
@@ -932,6 +945,35 @@ static int set_local_cert(SSL_CTX *ctx, php_stream *stream TSRMLS_DC) /* {{{ */
 }
 /* }}} */
 
+/* OpenSSL 4.0 removed the fixed-version methods (SSLv3_method(),
+ * TLSv1_method(), TLSv1_1_method(), TLSv1_2_method() and their client/server
+ * variants, deprecated since 1.1.0). Since 1.1.0 each of them was the
+ * version-flexible method pinned to one protocol version, so do the same:
+ * TLS_{client,server}_method() here, min = max protocol version in
+ * php_openssl_setup_crypto() once the context exists. */
+#if OPENSSL_VERSION_NUMBER >= 0x10100000L && !defined(LIBRESSL_VERSION_NUMBER)
+# define PHP_OPENSSL_PINNED_METHODS 1
+# define PHP_OPENSSL_FIXED_METHOD(is_client, client_method, server_method) \
+	((is_client) ? TLS_client_method() : TLS_server_method())
+
+static int php_openssl_get_pinned_proto_version(long method_value) /* {{{ */
+{
+	switch (method_value) {
+#if !defined(OPENSSL_NO_SSL3) && defined(SSL3_VERSION)
+		case STREAM_CRYPTO_METHOD_SSLv3:   return SSL3_VERSION;
+#endif
+		case STREAM_CRYPTO_METHOD_TLSv1_0: return TLS1_VERSION;
+		case STREAM_CRYPTO_METHOD_TLSv1_1: return TLS1_1_VERSION;
+		case STREAM_CRYPTO_METHOD_TLSv1_2: return TLS1_2_VERSION;
+		default:                           return 0;
+	}
+}
+/* }}} */
+#else
+# define PHP_OPENSSL_FIXED_METHOD(is_client, client_method, server_method) \
+	((is_client) ? client_method() : server_method())
+#endif
+
 static const SSL_METHOD *php_select_crypto_method(long method_value, int is_client TSRMLS_DC) /* {{{ */
 {
 	if (method_value == STREAM_CRYPTO_METHOD_SSLv2) {
@@ -944,17 +986,17 @@ static const SSL_METHOD *php_select_crypto_method(long method_value, int is_clie
 #endif
 	} else if (method_value == STREAM_CRYPTO_METHOD_SSLv3) {
 #ifndef OPENSSL_NO_SSL3
-		return is_client ? SSLv3_client_method() : SSLv3_server_method();
+		return PHP_OPENSSL_FIXED_METHOD(is_client, SSLv3_client_method, SSLv3_server_method);
 #else
 		php_error_docref(NULL TSRMLS_CC, E_WARNING,
 				"SSLv3 support is not compiled into the OpenSSL library PHP is linked against");
 		return NULL;
 #endif
 	} else if (method_value == STREAM_CRYPTO_METHOD_TLSv1_0) {
-		return is_client ? TLSv1_client_method() : TLSv1_server_method();
+		return PHP_OPENSSL_FIXED_METHOD(is_client, TLSv1_client_method, TLSv1_server_method);
 	} else if (method_value == STREAM_CRYPTO_METHOD_TLSv1_1) {
 #if OPENSSL_VERSION_NUMBER >= 0x10001001L
-		return is_client ? TLSv1_1_client_method() : TLSv1_1_server_method();
+		return PHP_OPENSSL_FIXED_METHOD(is_client, TLSv1_1_client_method, TLSv1_1_server_method);
 #else
 		php_error_docref(NULL TSRMLS_CC, E_WARNING,
 				"TLSv1.1 support is not compiled into the OpenSSL library PHP is linked against");
@@ -962,7 +1004,7 @@ static const SSL_METHOD *php_select_crypto_method(long method_value, int is_clie
 #endif
 	} else if (method_value == STREAM_CRYPTO_METHOD_TLSv1_2) {
 #if OPENSSL_VERSION_NUMBER >= 0x10001001L
-		return is_client ? TLSv1_2_client_method() : TLSv1_2_server_method();
+		return PHP_OPENSSL_FIXED_METHOD(is_client, TLSv1_2_client_method, TLSv1_2_server_method);
 #else
 		php_error_docref(NULL TSRMLS_CC, E_WARNING,
 				"TLSv1.2 support is not compiled into the OpenSSL library PHP is linked against");
@@ -1441,6 +1483,9 @@ int php_openssl_setup_crypto(php_stream *stream,
 		TSRMLS_DC) /* {{{ */
 {
 	const SSL_METHOD *method;
+#ifdef PHP_OPENSSL_PINNED_METHODS
+	int pinned_version = 0;
+#endif
 	long ssl_ctx_options;
 	long method_flags;
 	char *cipherlist = NULL;
@@ -1469,6 +1514,9 @@ int php_openssl_setup_crypto(php_stream *stream,
 		if (method == NULL) {
 			return FAILURE;
 		}
+#ifdef PHP_OPENSSL_PINNED_METHODS
+		pinned_version = php_openssl_get_pinned_proto_version(method_flags);
+#endif
 	} else {
 		method = sslsock->is_client ? SSLv23_client_method() : SSLv23_server_method();
 		ssl_ctx_options = php_get_crypto_method_ctx_flags(method_flags TSRMLS_CC);
@@ -1489,6 +1537,17 @@ int php_openssl_setup_crypto(php_stream *stream,
 		return FAILURE;
 	}
 
+#ifdef PHP_OPENSSL_PINNED_METHODS
+	if (pinned_version != 0 &&
+			(!SSL_CTX_set_min_proto_version(sslsock->ctx, pinned_version) ||
+			 !SSL_CTX_set_max_proto_version(sslsock->ctx, pinned_version))) {
+		php_error_docref(NULL TSRMLS_CC, E_WARNING, "Unable to limit the SSL context to the requested protocol version");
+		SSL_CTX_free(sslsock->ctx);
+		sslsock->ctx = NULL;
+		return FAILURE;
+	}
+#endif
+
 #if OPENSSL_VERSION_NUMBER >= 0x0090806fL
 	if (GET_VER_OPT("no_ticket") && zend_is_true(*val)) {
 		ssl_ctx_options |= SSL_OP_NO_TICKET;
