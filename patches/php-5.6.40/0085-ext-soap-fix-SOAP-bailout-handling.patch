From 3fefe2fdb29eff356161cf67a595c06891fc2578 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Wed, 25 Nov 2026 18:34:28 +0100
Subject: [PATCH] ext/soap: fix SOAP bailout handling

SoapClient::__call() reused the _bailout variable of
SOAP_CLIENT_BEGIN/END_CODE() after setjmp(). It is not volatile, so
reading it back after a longjmp is undefined; built with GCC 14 and
later, a SoapFault raised for an error in __call() cannot be caught and
ends the script without any message (ext/soap/tests/bugs/bug54911.phpt
and bug66112.phpt). Use a separate local variable instead, as upstream
does.

Backport of php-src 4f28bbda51 (Nikita Popov), Sury's 5.6 patch 0380.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ext/soap/soap.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/ext/soap/soap.c b/ext/soap/soap.c
index 864b0db3..260291a2 100644
--- a/ext/soap/soap.c
+++ b/ext/soap/soap.c
@@ -2687,6 +2687,7 @@ static void do_soap_call(zval* this_ptr,
 	HashTable *old_class_map;
 	int old_features;
 	HashTable *old_typemap, *typemap = NULL;
+	int bailout = 0;
 
 	SOAP_CLIENT_BEGIN_CODE();
 
@@ -2857,7 +2858,7 @@ static void do_soap_call(zval* this_ptr,
 		}
 
 	} zend_catch {
-		_bailout = 1;
+		bailout = 1;
 	} zend_end_try();
 
 	if (SOAP_GLOBAL(encoding) != NULL) {
@@ -2869,8 +2870,7 @@ static void do_soap_call(zval* this_ptr,
 	SOAP_GLOBAL(class_map) = old_class_map;
 	SOAP_GLOBAL(encoding) = old_encoding;
 	SOAP_GLOBAL(sdl) = old_sdl;
-	if (_bailout) {
-		_bailout = 0;
+	if (bailout) {
 		zend_bailout();
 	}
 	SOAP_CLIENT_END_CODE();
