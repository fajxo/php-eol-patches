diff --git a/ext/soap/php_xml.c b/ext/soap/php_xml.c
index 7131dacd..c5566357 100644
--- a/ext/soap/php_xml.c
+++ b/ext/soap/php_xml.c
@@ -278,6 +278,10 @@ int attr_is_equal_ex(xmlAttrPtr node, char *name, char *ns)
 
 int node_is_equal_ex(xmlNodePtr node, char *name, char *ns)
 {
+	/* A DTD node can carry the same name but is not an xmlNode. */
+	if (node->type != XML_ELEMENT_NODE) {
+		return FALSE;
+	}
 	if (name == NULL || ((node->name) && strcmp((char*)node->name, name) == 0)) {
 		if (ns) {
 			xmlNsPtr nsPtr = node_find_ns(node);
diff --git a/ext/soap/tests/dtd_named_like_root_request.phpt b/ext/soap/tests/dtd_named_like_root_request.phpt
new file mode 100644
index 00000000..4de437ec
--- /dev/null
+++ b/ext/soap/tests/dtd_named_like_root_request.phpt
@@ -0,0 +1,27 @@
+--TEST--
+SOAP: DOCTYPE named like the envelope is not taken for it when rejecting a request
+--SKIPIF--
+<?php require_once('skipif.inc'); ?>
+--FILE--
+<?php
+function test($x) {
+    return $x;
+}
+
+$request = <<<XML
+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE Envelope [<!NOTATION n SYSTEM "x">]>
+<env:Envelope xmlns:env="http://www.w3.org/2003/05/soap-envelope" xmlns:ns1="urn:test">
+  <env:Body>
+    <ns1:test><param0>x</param0></ns1:test>
+  </env:Body>
+</env:Envelope>
+XML;
+
+$server = new SoapServer(null, ['uri' => 'urn:test']);
+$server->addFunction('test');
+$server->handle($request);
+?>
+--EXPECT--
+<?xml version="1.0" encoding="UTF-8"?>
+<env:Envelope xmlns:env="http://www.w3.org/2003/05/soap-envelope"><env:Body><env:Fault><env:Code><env:Value>env:Receiver</env:Value></env:Code><env:Reason><env:Text>DTD are not supported by SOAP</env:Text></env:Reason></env:Fault></env:Body></env:Envelope>
diff --git a/ext/soap/tests/dtd_named_like_root_request_input.phpt b/ext/soap/tests/dtd_named_like_root_request_input.phpt
new file mode 100644
index 00000000..9bcf2bcb
--- /dev/null
+++ b/ext/soap/tests/dtd_named_like_root_request_input.phpt
@@ -0,0 +1,25 @@
+--TEST--
+SOAP: DOCTYPE named like the envelope is not taken for it when rejecting a posted request
+--POST--
+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE Envelope [<!NOTATION n SYSTEM "x">]>
+<SOAP-ENV:Envelope xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/" xmlns:ns1="urn:test">
+  <SOAP-ENV:Body>
+    <ns1:test><param0>x</param0></ns1:test>
+  </SOAP-ENV:Body>
+</SOAP-ENV:Envelope>
+--SKIPIF--
+<?php require_once('skipif.inc'); ?>
+--FILE--
+<?php
+function test($x) {
+    return $x;
+}
+
+$server = new SoapServer(null, ['uri' => 'urn:test']);
+$server->addFunction('test');
+$server->handle();
+?>
+--EXPECT--
+<?xml version="1.0" encoding="UTF-8"?>
+<SOAP-ENV:Envelope xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/"><SOAP-ENV:Body><SOAP-ENV:Fault><faultcode>SOAP-ENV:Server</faultcode><faultstring>DTD are not supported by SOAP</faultstring></SOAP-ENV:Fault></SOAP-ENV:Body></SOAP-ENV:Envelope>
diff --git a/ext/soap/tests/dtd_named_like_root_schema.phpt b/ext/soap/tests/dtd_named_like_root_schema.phpt
new file mode 100644
index 00000000..152ea728
--- /dev/null
+++ b/ext/soap/tests/dtd_named_like_root_schema.phpt
@@ -0,0 +1,22 @@
+--TEST--
+SOAP: DOCTYPE named like the schema root element is not taken for it
+--SKIPIF--
+<?php require_once('skipif.inc'); ?>
+--INI--
+soap.wsdl_cache_enabled=0
+--FILE--
+<?php
+$client = new SoapClient(__DIR__ . '/dtd_named_like_root_schema.wsdl');
+var_dump($client->__getTypes());
+?>
+--EXPECT--
+array(2) {
+  [0]=>
+  string(30) "struct Imported {
+ string a;
+}"
+  [1]=>
+  string(30) "struct Included {
+ string b;
+}"
+}
diff --git a/ext/soap/tests/dtd_named_like_root_schema.wsdl b/ext/soap/tests/dtd_named_like_root_schema.wsdl
new file mode 100644
index 00000000..be8c462c
--- /dev/null
+++ b/ext/soap/tests/dtd_named_like_root_schema.wsdl
@@ -0,0 +1,35 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
+             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
+             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
+             xmlns:tns="urn:test"
+             targetNamespace="urn:test"
+             name="Test">
+  <types>
+    <xsd:schema targetNamespace="urn:test">
+      <xsd:import namespace="urn:imported" schemaLocation="dtd_named_like_root_schema_import.xsd"/>
+      <xsd:include schemaLocation="dtd_named_like_root_schema_include.xsd"/>
+    </xsd:schema>
+  </types>
+  <message name="echoRequest"><part name="p" type="tns:Included"/></message>
+  <message name="echoResponse"><part name="r" type="tns:Included"/></message>
+  <portType name="TestPort">
+    <operation name="echo">
+      <input message="tns:echoRequest"/>
+      <output message="tns:echoResponse"/>
+    </operation>
+  </portType>
+  <binding name="TestBinding" type="tns:TestPort">
+    <soap:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
+    <operation name="echo">
+      <soap:operation soapAction="urn:test#echo"/>
+      <input><soap:body use="encoded" namespace="urn:test" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/></input>
+      <output><soap:body use="encoded" namespace="urn:test" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/></output>
+    </operation>
+  </binding>
+  <service name="TestService">
+    <port name="TestPort" binding="tns:TestBinding">
+      <soap:address location="http://localhost/test"/>
+    </port>
+  </service>
+</definitions>
diff --git a/ext/soap/tests/dtd_named_like_root_schema_import.xsd b/ext/soap/tests/dtd_named_like_root_schema_import.xsd
