diff --git a/sapi/fpm/tests/ghsa-qc49-hpvq-g2w6.inc b/sapi/fpm/tests/ghsa-qc49-hpvq-g2w6.inc
new file mode 100644
index 00000000..a58445fb
--- /dev/null
+++ b/sapi/fpm/tests/ghsa-qc49-hpvq-g2w6.inc
@@ -0,0 +1,50 @@
+<?php
+/* Raw FastCGI helpers for the GHSA-qc49-hpvq-g2w6 tests (5.6 port of the
+ * helpers in upstream unread-body-*.phpt). */
+
+function ghsa_record($type, $content, $id)
+{
+	return pack('CCnnCC', 1, $type, $id, strlen($content), 0, 0) . $content;
+}
+
+function ghsa_encode_length($length)
+{
+	return $length < 128 ? chr($length) : pack('N', $length | 0x80000000);
+}
+
+function ghsa_params($params)
+{
+	$encoded = '';
+	foreach ($params as $name => $value) {
+		$encoded .= ghsa_encode_length(strlen($name)) . ghsa_encode_length(strlen($value)) . $name . $value;
+	}
+	return $encoded;
+}
+
+function ghsa_request($id, $keep, $params, $stdin)
+{
+	return ghsa_record(1, pack('nCxxxxx', 1, $keep ? 1 : 0), $id)
+		. ghsa_record(4, ghsa_params($params), $id)
+		. ghsa_record(4, '', $id)
+		. ghsa_record(5, $stdin, $id)
+		. ghsa_record(5, '', $id);
+}
+
+function ghsa_transact($host, $port, $request)
+{
+	$socket = fsockopen($host, $port);
+	stream_set_timeout($socket, 3);
+	$written = 0;
+	while ($written < strlen($request)) {
+		$written += fwrite($socket, substr($request, $written));
+	}
+	stream_socket_shutdown($socket, STREAM_SHUT_WR);
+	$response = stream_get_contents($socket);
+	fclose($socket);
+	return $response;
+}
+
+function ghsa_has($haystack, $needle)
+{
+	return strpos($haystack, $needle) !== false;
+}
From 3da9b04f800be4618bb9866e584b45a3fcc1aa53 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Thu, 19 Nov 2026 16:48:33 +0100
Subject: [PATCH] Fix GHSA-3mg3-cr28-46gc (CVE-2026-129292): escape all
 client-controlled fields in FPM full status

Backport of php-src 37abd0a7f7 ("Fix GHSA-3mg3-cr28-46gc: FPM XSS within
status endpoint via user and script", PHP-8.2).

The 5.6 code was worse than 8.2 before the fix: request method, request
URI, auth user and script filename were printed raw in every format; the
query string was escaped only for html/xml, with flags
`ENT_HTML_IGNORE_ERRORS & ENT_COMPAT` (= 0: double quotes not escaped,
invalid UTF-8 made the field empty and leaked the buffer); JSON output
escaped nothing.

Now request_method, request_uri, query_string, auth_user and
script_filename go through one helper, fpm_status_escape():
- html/xml: php_escape_html_entities_ex() (5.6 signature: newlen out
  param, TSRMLS_CC) with all = 0 and ENT_HTML_IGNORE_ERRORS |
  ENT_DISALLOWED | ENT_HTML_DOC_XML1 | ENT_QUOTES, charset hint NULL
  (= UTF-8). XML1 keeps output to XML-safe entities (upstream uses the
  same doctype; it forces all = 0 anyway); ENT_QUOTES escapes both
  quote kinds; invalid UTF-8 bytes are dropped instead of blanking the
  field.
- json: 5.6 has no php_json_encode_string(), so a small static escaper
  (fpm_status_escape_json) backslash-escapes '"' and '\' and writes
  control characters < 0x20 as \u00XX. The JSON branch now sets
  encode = 2.
- text/plain: unchanged (raw).
Every escaped copy is efree()d after the line is printed.

Test: upstream ghsa-3mg3-cr28-46gc-status-xss.phpt rewritten for the
5.6 FPM harness (include.inc/fcgi.inc async_request instead of
FPM\Tester::multiRequest); also checks the xml output.

Not compiled or tested yet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sapi/fpm/fpm/fpm_status.c                     | 100 +++++++++++++++---
 .../tests/ghsa-3mg3-cr28-46gc-status-xss.phpt | 100 ++++++++++++++++++
 2 files changed, 183 insertions(+), 17 deletions(-)
 create mode 100644 sapi/fpm/tests/ghsa-3mg3-cr28-46gc-status-xss.phpt

diff --git a/sapi/fpm/fpm/fpm_status.c b/sapi/fpm/fpm/fpm_status.c
index a2ee398d..dcfa797f 100644
--- a/sapi/fpm/fpm/fpm_status.c
+++ b/sapi/fpm/fpm/fpm_status.c
@@ -46,6 +46,61 @@ int fpm_status_init_child(struct fpm_worker_pool_s *wp) /* {{{ */
 }
 /* }}} */
 
+/* JSON string escaping: '"', '\\' and control characters; the result must be efree()d */
+static char *fpm_status_escape_json(const char *str, size_t len) /* {{{ */
+{
+	static const char hex[] = "0123456789abcdef";
+	char *escaped, *p;
+	size_t i;
+
+	/* worst case: every byte becomes \u00XX */
+	escaped = safe_emalloc(len, 6, 1);
+	p = escaped;
+	for (i = 0; i < len; i++) {
+		unsigned char c = (unsigned char) str[i];
+
+		if (c == '"' || c == '\\') {
+			*p++ = '\\';
+			*p++ = c;
+		} else if (c < 0x20) {
+			*p++ = '\\';
+			*p++ = 'u';
+			*p++ = '0';
+			*p++ = '0';
+			*p++ = hex[c >> 4];
+			*p++ = hex[c & 0xf];
+		} else {
+			*p++ = c;
+		}
+	}
+	*p = '\0';
+	return escaped;
+}
+/* }}} */
+
+/* encode: 0 = none, 1 = HTML/XML, 2 = JSON. Returns NULL for an empty field;
+ * when *tmp is set on return it must be efree()d */
+static char *fpm_status_escape(char *str, int encode, char **tmp TSRMLS_DC) /* {{{ */
+{
+	size_t len;
+
+	*tmp = NULL;
+	if (str[0] == '\0') {
+		return NULL;
+	}
+	if (encode == 1) {
+		*tmp = php_escape_html_entities_ex((unsigned char *) str, strlen(str), &len, 0,
+				ENT_HTML_IGNORE_ERRORS | ENT_DISALLOWED | ENT_HTML_DOC_XML1 | ENT_QUOTES, NULL, 1 TSRMLS_CC);
+		return *tmp;
+	}
+	if (encode == 2) {
+		*tmp = fpm_status_escape_json(str, strlen(str));
+		return *tmp;
+	}
+	return str;
+}
+/* }}} */
+
 int fpm_status_handle_request(TSRMLS_D) /* {{{ */
 {
 	struct fpm_scoreboard_s scoreboard, *scoreboard_p;
@@ -262,6 +317,7 @@ int fpm_status_handle_request(TSRMLS_D) /* {{{ */
 		} else if (fpm_php_get_string_from_table("_GET", "json" TSRMLS_CC)) {
 			sapi_add_header_ex(ZEND_STRL("Content-Type: application/json"), 1, 1 TSRMLS_CC);
 			time_format = "%s";
+			encode = 2;
 
 			short_syntax =
 				"{"
@@ -384,8 +440,10 @@ int fpm_status_handle_request(TSRMLS_D) /* {{{ */
 		/* no need to test the var 'full' */
 		if (full_syntax) {
 			int i, first;
-			size_t len;
-			char *query_string;
+			char *request_method_string, *request_uri_string, *query_string;
+			char *auth_user_string, *script_filename_string;
+			char *tmp_request_method_string, *tmp_request_uri_string, *tmp_query_string;
+			char *tmp_auth_user_string, *tmp_script_filename_string;
 			struct timeval duration, now;
 #ifdef HAVE_FPM_LQ
 			float cpu;
@@ -412,15 +470,11 @@ int fpm_status_handle_request(TSRMLS_D) /* {{{ */
