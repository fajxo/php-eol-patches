From 03f46e874e9b12140f4b1b3563b604d214bad2a2 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Thu, 19 Nov 2026 16:53:06 +0100
Subject: [PATCH] Fix GHSA-fm2m-fjf5-v3cp (CVE-2026-126714): always truncate
 the session file before writing

Backport of php-src e2d3cee9ad ("Fix GHSA-fm2m-fjf5-v3cp: RCE via
corrupted session file", PHP-8.2).

The files handler truncated the session file only when the new data was
shorter than the old file. If the write was interrupted, the file could
hold the start of the new session followed by the tail of the old one,
and unserializing that concatenation could be steered by an attacker.
Always ftruncate() to 0 before writing, and fail the write if the
truncate fails.

Differences from upstream: 5.6 has the logic inline in
PS_WRITE_FUNC(files) (no ps_files_write()), with char *val/int vallen;
php_error_docref() takes TSRMLS_CC. No upstream test.

Behaviour note: every session write now truncates first (one extra
syscall; a write of identical length no longer overwrites in place).

Not compiled or tested yet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ext/session/mod_files.c | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/ext/session/mod_files.c b/ext/session/mod_files.c
index 5c69ae33..9bf4ff63 100644
--- a/ext/session/mod_files.c
+++ b/ext/session/mod_files.c
@@ -414,10 +414,9 @@ PS_WRITE_FUNC(files)
 		return FAILURE;
 	}
 
-	/* Truncate file if the amount of new data is smaller than the existing data set. */
-
-	if (vallen < (int)data->st_size) {
-		php_ignore_value(ftruncate(data->fd, 0));
+	if (ftruncate(data->fd, 0) != 0) {
+		php_error_docref(NULL TSRMLS_CC, E_WARNING, "ftruncate() failed: %s (%d)", strerror(errno), errno);
+		return FAILURE;
 	}
 
 #if defined(HAVE_PWRITE)
From d0f516bfc33ac73f55db0f4d8d8acc1fb4796902 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Thu, 19 Nov 2026 16:54:07 +0100
Subject: [PATCH] Fix GHSA-68fq-fh7h-f8gr (CVE-2026-128090): refuse keyless
 phar signature when .pubkey exists

Backport of php-src db90b7ba0d ("Fix GHSA-68fq-fh7h-f8gr: refuse keyless
phar signature when .pubkey exists", PHP-8.2).

The signature type is not covered by the signature, so an OpenSSL-signed
phar (phar, tar or zip format) could be re-signed with a keyless hash
(MD5/SHA1/SHA256/SHA512) and still load. In phar_verify_signature(),
fail any non-OpenSSL signature when "<phar>.pubkey" exists.

Differences from upstream:
- 5.6 knows only PHAR_SIG_OPENSSL (no _SHA256/_SHA512 OpenSSL variants),
  so the condition is `sig_type != PHAR_SIG_OPENSSL`.
- zend_bool instead of bool; php_stream_stat_path_ex() is the 5.6 macro
  that adds TSRMLS_CC itself (phar_verify_signature has TSRMLS_DC).
- The OpenSSL branch and the phar_call_openssl_signverify() UAF fix
  (0b4b8a66) are untouched; the new block sits between
  php_stream_rewind() and the switch.
- Test ghsa-68fq-fh7h-f8gr.phpt: no typed params/return types, unpack()
  results dereferenced via helpers/temporaries, extensions and SHA-256
  support checked in SKIPIF. Expected messages match the 5.6 phar.c,
  tar.c and zip.c error formats (same as upstream).

Behaviour note: a phar with a stray .pubkey next to it that is signed
with a plain hash now fails to open.

Not compiled or tested yet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ext/phar/tests/ghsa-68fq-fh7h-f8gr.phpt | 138 ++++++++++++++++++++++++
 ext/phar/util.c                         |  17 +++
 2 files changed, 155 insertions(+)
 create mode 100644 ext/phar/tests/ghsa-68fq-fh7h-f8gr.phpt

diff --git a/ext/phar/tests/ghsa-68fq-fh7h-f8gr.phpt b/ext/phar/tests/ghsa-68fq-fh7h-f8gr.phpt
new file mode 100644
index 00000000..8c8c899d
--- /dev/null
+++ b/ext/phar/tests/ghsa-68fq-fh7h-f8gr.phpt
@@ -0,0 +1,138 @@
+--TEST--
+GHSA-68fq-fh7h-f8gr (OpenSSL signature bypass by downgrading the algorithm to a keyless one)
+--SKIPIF--
+<?php
+if (!extension_loaded("phar")) die("skip phar extension not available");
+if (!extension_loaded("openssl")) die("skip openssl extension not available");
+if (!in_array("OpenSSL", Phar::getSupportedSignatures())) die("skip openssl support required");
+if (!in_array("SHA-256", Phar::getSupportedSignatures())) die("skip SHA-256 support required");
+?>
+--INI--
+phar.readonly=0
+phar.require_hash=1
+--FILE--
+<?php
+$base = __DIR__ . '/' . basename(__FILE__, '.php');
+$private = openssl_pkey_get_private(file_get_contents(__DIR__ . '/files/private.pem'));
+$pkey = '';
+openssl_pkey_export($private, $pkey, null, array('config' => __DIR__ . '/files/openssl.cnf'));
+$details = openssl_pkey_get_details($private);
+$pubkey = $details['key'];
+
+function build($file, $pkey)
+{
+    $phar = new Phar($file);
+    $phar['main.php'] = '<?php echo "GENUINE\n";';
+    $phar->setStub('<?php __HALT_COMPILER();');
+    $phar->setSignatureAlgorithm(Phar::OPENSSL, $pkey);
+
+    return file_get_contents($file);
+}
+
+// a phar built in this process comes back from the cache, so each case is read under its own name
+function open($file, $archive, $pubkey)
+{
+    file_put_contents($file, $archive);
+    if ($pubkey !== null) {
+        file_put_contents($file . '.pubkey', $pubkey);
+    }
+
+    try {
+        $phar = new Phar($file);
+        $signature = $phar->getSignature();
+        echo $signature['hash_type'], "\n";
+    } catch (UnexpectedValueException $e) {
+        echo $e->getMessage(), "\n";
+    }
+}
+
+function downgrade_phar($archive)
+{
+    // the last 12 bytes are [length][algorithm]["GBMB"], the signature sits just before them
+    $siglen = unpack('V', substr($archive, -12, 4));
+    $siglen = $siglen[1];
+    $message = substr($archive, 0, strlen($archive) - 12 - $siglen);
+
+    return $message . hash('sha256', $message, true) . pack('V', 0x0003) . 'GBMB'; // 0x0003 is PHAR_SIG_SHA256
+}
+
+function downgrade_tar($archive)
+{
+    for ($offset = 0; $offset + 512 <= strlen($archive); ) {
+        $size = (int) octdec(trim(substr($archive, $offset + 124, 12), " \0")); // octal size field of a 512 byte header
+
+        if (rtrim(substr($archive, $offset, 100), "\0") === '.phar/signature.bin') {
+            // the signed message stops at this header, so rewriting the entry content leaves it alone
+            $blob = pack('VV', 0x0003, 32) . hash('sha256', substr($archive, 0, $offset), true); // [algorithm][digest length][digest]
+
+            return substr_replace($archive, str_pad($blob, $size, "\0"), $offset + 512, $size);
+        }
+
+        $offset += 512 + (($size + 511) & ~511);
+    }
+
+    throw new RuntimeException('no signature entry');
+}
+
+function u16($data, $offset)
+{
+    $v = unpack('v', substr($data, $offset, 2));
+    return $v[1];
+}
+
+function u32($data, $offset)
+{
+    $v = unpack('V', substr($data, $offset, 4));
+    return $v[1];
+}
+
+function downgrade_zip($archive)
+{
+    $eocd = strrpos($archive, "PK\x05\x06");
+    $cdir = u32($archive, $eocd + 16); // the eocd holds the directory offset at +16 and the archive comment length at +20
+    $comment = substr($archive, $eocd + 22, u16($archive, $eocd + 20));
+
+    for ($record = $cdir; substr($archive, $record, 4) === "PK\x01\x02"; ) {
+        $namelen = u16($archive, $record + 28);
+
+        if (substr($archive, $record + 46, $namelen) === '.phar/signature.bin') {
+            $size = u32($archive, $record + 24);
+            $local = u32($archive, $record + 42);
+            $content = $local + 30 + u16($archive, $local + 26) + u16($archive, $local + 28);
+            // the signed message is everything before the local entry plus the directory up to this record
+            $message = substr($archive, 0, $local) . substr($archive, $cdir, $record - $cdir) . $comment;
+            $blob = pack('VV', 0x0003, 32) . hash('sha256', $message, true);
+
+            return substr_replace($archive, str_pad($blob, $size, "\0"), $content, $size);
+        }
+
+        $record += 46 + $namelen + u16($archive, $record + 30) + u16($archive, $record + 32);
+    }
+
+    throw new RuntimeException('no signature entry');
+}
+
+foreach (array('phar' => 'downgrade_phar', 'phar.tar' => 'downgrade_tar', 'phar.zip' => 'downgrade_zip') as $suffix => $downgrade) {
+    $archive = build($base . '.source.' . $suffix, $pkey);
+    open($base . '.signed.' . $suffix, $archive, $pubkey);
+    open($base . '.tampered.' . $suffix, $downgrade($archive), $pubkey);
+    open($base . '.nokey.' . $suffix, $downgrade($archive), null);
+}
+?>
+--CLEAN--
+<?php
+$base = __DIR__ . '/' . basename(__FILE__, '.clean.php');
+foreach (glob($base . '.*.phar*') as $file) {
+    unlink($file);
+}
+?>
+--EXPECTF--
+OpenSSL
+phar "%stampered.phar" SHA256 signature could not be verified: openssl public key found, but the signature does not use openssl
+SHA-256
+OpenSSL
+phar error: tar-based phar "%stampered.phar.tar" signature cannot be verified: openssl public key found, but the signature does not use openssl
+SHA-256
+OpenSSL
+phar error: signature cannot be verified: openssl public key found, but the signature does not use openssl in zip-based phar "%stampered.phar.zip"
+SHA-256
diff --git a/ext/phar/util.c b/ext/phar/util.c
index f1eeb2f0..83680995 100644
--- a/ext/phar/util.c
+++ b/ext/phar/util.c
@@ -1529,6 +1529,23 @@ int phar_verify_signature(php_stream *fp, size_t end_of_phar, php_uint32 sig_typ
 
 	php_stream_rewind(fp);
 
+	if (sig_type != PHAR_SIG_OPENSSL) {
+		php_stream_statbuf ssb;
+		char *pfile;
+		zend_bool has_pubkey;
+
