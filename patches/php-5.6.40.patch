+    }
+}
+
+$server = new SoapServer(WSDL);
+$server->addFunction(array('itemType', 'sizeOnly'));
+
+foreach (array('itemType', 'sizeOnly') as $operation) {
+    ob_start();
+    $server->handle(request($operation));
+    $response = ob_get_clean();
+
+    preg_match('/arraySize="[^"]*"/', $response, $matches);
+    echo 'encode ', $operation, ' => ', isset($matches[0]) ? $matches[0] : 'none', "\n";
+}
+
+foreach (array('ItemType', 'SizeOnly') as $arrayType) {
+    $client = new ReplayClient($arrayType);
+    $method = lcfirst($arrayType);
+    echo 'decode ', $arrayType, ' => ', json_encode($client->$method()), "\n";
+}
+
+?>
