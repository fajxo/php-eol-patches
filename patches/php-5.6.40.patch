+<?php
+include "include.inc";
+
+$php = get_cgi_path();
+$script = __DIR__ . "/ghsa-5j3f-64r7-f564.target.php";
+file_put_contents($script, '<?php var_dump(isset($_SERVER["PATH_INFO"]) ? $_SERVER["PATH_INFO"] : null, isset($_SERVER["ORIG_PATH_INFO"]) ? $_SERVER["ORIG_PATH_INFO"] : null);');
