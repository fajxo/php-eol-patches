@@ -0,0 +1,39 @@
+--TEST--
+Single-char relative Location header keeps resolving against the host root (pre-GH-23467 behavior)
+--DESCRIPTION--
+Not RFC 3986 compliant ("x" against "/a/b" gives "/a/x"), but matches
+PHP's long-standing behavior of resolving against the host root. See GH-23521.
+--FILE--
+<?php
+$serverCode = <<<'CODE'
+$server = stream_socket_server("tcp://127.0.0.1:0", $errno, $errstr);
+phpt_notify_server_start($server);
+
+for ($n = 0; $n < 2; $n++) {
+    $conn = stream_socket_accept($server, 10);
+    if (!$conn) {
+        break;
+    }
+    $req = fgets($conn);
+    while (trim(fgets($conn)) !== '') {}
+    $uri = explode(' ', $req)[1];
+    if ($n < 1) {
+        fwrite($conn, "HTTP/1.1 302 Found\r\nLocation: x\r\nContent-Length: 0\r\n\r\n");
+    } else {
+        $body = "uri=$uri";
+        fwrite($conn, "HTTP/1.1 200 OK\r\nContent-Length: " . strlen($body) . "\r\n\r\n$body");
+    }
+    fclose($conn);
+}
+CODE;
+
+$clientCode = <<<'CODE'
+$ctx = stream_context_create(['http' => ['follow_location' => 1]]);
+echo @file_get_contents("http://{{ ADDR }}/a/b", false, $ctx), "\n";
+CODE;
+
+include sprintf("%s/ServerClientTestCase.inc", __DIR__);
+ServerClientTestCase::getInstance()->run($clientCode, $serverCode);
+?>
+--EXPECT--
+uri=/x
From 27f5c90ae2ae55e4df516b4dac74db7ed6431a7f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Wed, 25 Nov 2026 12:21:46 +0100
Subject: [PATCH] Fix GHSA-mmf9-xm3v-hg2x (CVE-2026-127960): folded header DoS

Each folded continuation line copied the whole header line collected
so far into a new string, so a header split into many continuation
lines took quadratic time: a few MB of headers could stall the client
for a long time. The last header line is now built in a smart_str.

Our own port: Sury has no 5.6 patch for it. It follows php-src
a303f69726 (Jakub Zelenka) as in Sury's 7.2 patch 0268, with 5.6's
smart_str: the buffer is taken over by hand, as 5.6 has no
smart_str_extract(). Needs the header folding change (GHSA-v8xr) first.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
