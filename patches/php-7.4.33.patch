+static zend_string *fpm_status_json_escape(const char *str, size_t len) /* {{{ */
+{
+	static const char digits[] = "0123456789abcdef";
+	smart_str buf = {0};
+	size_t pos = 0;
+
+	while (pos < len) {
+		size_t start = pos;
+		int status;
+		unsigned int c = php_next_utf8_char((const unsigned char *) str, len, &pos, &status);
+
+		if (status != SUCCESS) {
+			continue;
+		}
+		if (c == '"' || c == '\\' || c == '/') {
+			smart_str_appendc(&buf, '\\');
+			smart_str_appendc(&buf, (char) c);
+		} else if (c < 0x20) {
+			smart_str_appendl(&buf, "\\u00", 4);
+			smart_str_appendc(&buf, digits[c >> 4]);
+			smart_str_appendc(&buf, digits[c & 0xf]);
+		} else {
+			smart_str_appendl(&buf, str + start, pos - start);
+		}
+	}
+	return smart_str_extract(&buf);
+}
+/* }}} */
