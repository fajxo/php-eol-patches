From 60698d1a24b9e4b299127d2814d36c6b498e3851 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Mon, 23 Nov 2026 22:29:49 +0100
Subject: [PATCH] Fix GHSA-jm4m-qfqx-967m (CVE-2026-129291): FPM stdio event
 left queued after worker exit

When a worker exits while a process it started still holds its stdout or
stderr pipe open, the master gets no EOF on that pipe. fpm_child_close()
then closed the fd and freed the child, but left &child->ev_stdout /
&child->ev_stderr registered in fpm_event_queue_fd and in epoll. The
queue kept a pointer into freed memory, and the fd number is reused by the
next worker's pipe: a use-after-free in the master process, which runs as
root, triggerable from PHP code running in a pool.

Remove the event before closing the fd when we are in the event loop, and
mark the fd closed so it is not closed twice.

Backport of php-src cd161267c0 (GH-24046) for EOL 7.4.33. The
fpm_child_close() change is identical. The upstream test is included,
changed only because this version's FPM tester has no
expectNoLogPattern(): the test reads the rest of the master log itself.
The test also waits at its end until the pool's port can be bound again:
the background process inherits the worker's listening socket and would
hold the port for the next test.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 sapi/fpm/fpm/fpm_children.c                   |  8 ++
 .../gh24046-stdio-pipe-double-close.phpt      | 73 +++++++++++++++++++
 2 files changed, 81 insertions(+)
 create mode 100644 sapi/fpm/tests/gh24046-stdio-pipe-double-close.phpt

diff --git a/sapi/fpm/fpm/fpm_children.c b/sapi/fpm/fpm/fpm_children.c
index 912f77c1..eedc013a 100644
--- a/sapi/fpm/fpm/fpm_children.c
+++ b/sapi/fpm/fpm/fpm_children.c
@@ -71,7 +71,11 @@ static void fpm_child_close(struct fpm_child_s *child, int in_event_loop) /* {{{
 			fpm_event_fire(&child->ev_stdout);
 		}
 		if (child->fd_stdout != -1) {
+			if (in_event_loop) {
+				fpm_event_del(&child->ev_stdout);
+			}
 			close(child->fd_stdout);
+			child->fd_stdout = -1;
 		}
 	}
 
@@ -80,7 +84,11 @@ static void fpm_child_close(struct fpm_child_s *child, int in_event_loop) /* {{{
 			fpm_event_fire(&child->ev_stderr);
 		}
 		if (child->fd_stderr != -1) {
+			if (in_event_loop) {
+				fpm_event_del(&child->ev_stderr);
+			}
 			close(child->fd_stderr);
+			child->fd_stderr = -1;
 		}
 	}
 
diff --git a/sapi/fpm/tests/gh24046-stdio-pipe-double-close.phpt b/sapi/fpm/tests/gh24046-stdio-pipe-double-close.phpt
new file mode 100644
index 00000000..15f8ee18
--- /dev/null
+++ b/sapi/fpm/tests/gh24046-stdio-pipe-double-close.phpt
@@ -0,0 +1,73 @@
+--TEST--
+GH-24046 (FPM: worker stdio pipe fd closed twice when a child process outlives the worker)
+--SKIPIF--
+<?php include "skipif.inc"; ?>
+--FILE--
+<?php
+
+require_once "tester.inc";
+
+$cfg = <<<EOT
+[global]
+error_log = {{FILE:LOG}}
+[unconfined]
+listen = {{ADDR}}
+pm = static
+pm.max_children = 1
+pm.max_requests = 1
+catch_workers_output = yes
+decorate_workers_output = no
+EOT;
+
+$code = <<<'EOT'
+<?php
+/* dup() of the worker's stderr pipe that is inherited by the background process */
+$stderr = fopen('php://stderr', 'a');
+if (@fwrite($stderr, "log line\n") === false) {
+    echo "write to stderr failed";
+    exit;
+}
+if (isset($_GET['bg'])) {
+    exec('sleep 3 > /dev/null 2>&1 &');
+}
+echo "ok";
+EOT;
+
+$tester = new FPM\Tester($cfg, $code);
+$tester->start();
+$tester->expectLogStartNotices();
+/* The worker exits after this request while the background process still holds
+ * its stderr pipe open. The replacement worker gets the same pipe fd numbers. */
+$tester->request('bg=1')->expectBody('ok');
+/* Wait for the postponed free of the exited worker. */
+usleep(1500000);
+$tester->request()->expectBody('ok');
+$tester->terminate();
+/* The tester in this branch has no expectNoLogPattern(): read the rest of
+ * the master's output and look for the epoll/stdio errors ourselves. */
+foreach ($tester->getLogLines(-1, true) as $line) {
+    if (preg_match('/unable to (remove|read)/', $line)) {
+        echo "unexpected log line: $line\n";
+    }
+}
+$tester->close();
+/* The background sleep inherited the worker's listening socket. Wait until it
+ * has exited, so the next test can bind the same port. */
+for ($i = 0; $i < 50; $i++) {
+    $probe = @stream_socket_server('tcp://' . $tester->getAddr());
+    if ($probe) {
+        fclose($probe);
+        break;
+    }
+    usleep(100000);
+}
+
+?>
+Done
+--EXPECT--
+Done
+--CLEAN--
+<?php
+require_once "tester.inc";
+FPM\Tester::clean();
+?>
From 46604ee51f7dc87f8417b022994fbccce422e262 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Mon, 23 Nov 2026 22:30:02 +0100
Subject: [PATCH] Fix GHSA-658j-r8rw-q6mx (CVE-2026-115560):
 session.upload_progress.enabled off by default

The upload progress hook writes attacker-controlled data into the session
with the session's serializer. When an application reads the same session
with a different serializer, that can lead to code execution. Upstream
turned the feature off by default and added a runtime check of the
session INI settings.

In this tree the upload progress hook is already a no-op since the
CVE-2026-109618 fix (php_session_rfc1867_callback() returns early), so
this change only makes the default say so: session.upload_progress.enabled
now defaults to "0", also in the globals initialisation. The runtime
check is not backported, as in the upstream EOL backports.

Backport of php-src 3f70f66611 for EOL 7.4.33; the change is identical.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
