+require_once "tester.inc";
+
+function record(int $type, string $content, int $id): string
+{
+    return pack('CCnnCC', 1, $type, $id, strlen($content), 0, 0) . $content;
+}
+
+function params(array $params): string
+{
+    $encoded = '';
+    $encodeLength = static fn(int $length): string => $length < 128
+        ? chr($length)
+        : pack('N', $length | 0x80000000);
+    foreach ($params as $name => $value) {
+        $encoded .= $encodeLength(strlen($name)) . $encodeLength(strlen($value)) . $name . $value;
+    }
+    return $encoded;
+}
+
+function request(int $id, bool $keep, array $params, string $stdin): string
+{
+    return record(1, pack('nCxxxxx', 1, $keep), $id)
+        . record(4, params($params), $id)
+        . record(4, '', $id)
+        . record(5, $stdin, $id)
+        . record(5, '', $id);
+}
+
+function transact(string $address, string $request): string
+{
+    [$host, $port] = explode(':', $address);
+    $socket = fsockopen($host, (int) $port);
+    stream_set_timeout($socket, 3);
+    $written = 0;
+    while ($written < strlen($request)) {
+        $written += fwrite($socket, substr($request, $written));
+    }
+    stream_socket_shutdown($socket, STREAM_SHUT_WR);
+    $response = stream_get_contents($socket);
+    fclose($socket);
+    return $response;
+}
+
+$config = <<<CFG
+[global]
+error_log = {{FILE:LOG}}
+[unconfined]
+listen = {{ADDR}}
+pm = static
+pm.max_children = 1
+catch_workers_output = yes
+CFG;
+
+$code = <<<'PHP'
+<?php
+if ($_SERVER['REMOTE_ADDR'] === '203.0.113.1') {
+    echo "smuggled\n";
+} else {
+    echo "outer ", strlen(file_get_contents('php://input')), "\n";
+}
+PHP;
+
+$tester = new FPM\Tester($config, $code);
+$script = $tester->makeSourceFile();
+$tester->start();
+$tester->expectLogStartNotices();
+
+$hiddenParams = [
+    'GATEWAY_INTERFACE' => 'FastCGI/1.0',
+    'REQUEST_METHOD' => 'GET',
+    'SCRIPT_FILENAME' => $script,
+    'SCRIPT_NAME' => '/smuggled.php',
+    'REQUEST_URI' => '/smuggled.php',
+    'SERVER_PROTOCOL' => 'HTTP/1.1',
+    'REMOTE_ADDR' => '203.0.113.1',
+    'CONTENT_LENGTH' => '0',
+];
+$hidden = request(2, false, $hiddenParams, '');
+$outerParams = [
+    'GATEWAY_INTERFACE' => 'FastCGI/1.0',
+    'REQUEST_METHOD' => 'POST',
+    'SCRIPT_FILENAME' => $script,
+    'SCRIPT_NAME' => '/open.php',
+    'REQUEST_URI' => '/open.php',
+    'SERVER_PROTOCOL' => 'HTTP/1.1',
+    'REMOTE_ADDR' => '127.0.0.1',
+    'CONTENT_TYPE' => 'application/octet-stream',
+    'CONTENT_LENGTH' => '1',
+];
+$plainParams = ['REQUEST_METHOD' => 'GET', 'CONTENT_LENGTH' => '0'] + $outerParams;
+unset($plainParams['CONTENT_TYPE']);
+
+/* The STDIN record is longer than CONTENT_LENGTH so it is left partially read. */
+foreach ([false, true] as $keep) {
+    $response = transact($tester->getAddr(), request(1, $keep, $outerParams, 'A' . $hidden));
+    echo 'keep ', $keep ? 'on' : 'off', ': ',
+        strpos($response, 'smuggled') !== false ? 'smuggled' : 'safe', ', ',
+        strpos($response, 'outer 1') !== false ? 'served' : 'not served', "\n";
+    /* The only worker must still serve new connections. */
+    foreach ([1, 2] as $n) {
+        $response = transact($tester->getAddr(), request(1, false, $plainParams, ''));
+        echo "  next connection $n: ", strpos($response, 'outer 0') !== false ? 'served' : 'not served', "\n";
+    }
+}
+
+$tester->terminate();
+$tester->close();
+?>
+--EXPECT--
+keep off: safe, served
+  next connection 1: served
+  next connection 2: served
+keep on: safe, served
+  next connection 1: served
+  next connection 2: served
+--CLEAN--
+<?php
+require_once "tester.inc";
+FPM\Tester::clean();
+?>
From 2fc736196fb684599948e0998cfb17db3a2cb236 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Thu, 19 Nov 2026 16:47:18 +0100
Subject: [PATCH] Fix GHSA-3mg3-cr28-46gc (CVE-2026-129292): FPM status page
 XSS via method, URI, user and script

The full FPM status page printed the request method, request URI, auth
user and script filename raw in every format; the query string was only
"escaped" for html/xml, with flags ENT_HTML_IGNORE_ERRORS & ENT_COMPAT
(= 0, so no quote escaping), and the JSON output was never escaped.
Escape all client-influenced fields through one helper.

Backport of php-src 37abd0a7f7 for EOL 7.4.33. 7.4 never got the earlier
GHSA-7qg2-v9fj-4mwv request-URI fix, so this covers it too. Differences:
- html/xml: php_escape_html_entities_ex() with the 7.4 signature (no
  quiet arg) and ENT_QUOTES | ENT_SUBSTITUTE | ENT_DISALLOWED |
  ENT_HTML_DOC_XML1 (upstream: ENT_COMPAT without ENT_SUBSTITUTE), so
  single quotes are escaped and invalid UTF-8 becomes U+FFFD instead of
  an empty string
- json: 7.4 has no php_json_encode_string() and ext/json can be built
  out, so a small static escaper is used: '"', '\\', '/' backslashed,
  control chars < 0x20 as \u00XX, invalid UTF-8 dropped (same as
  PHP_JSON_INVALID_UTF8_IGNORE upstream)
- a separate encode_json flag next to the existing encode (html/xml) one
- temporaries freed with zend_string_release_ex() (safe for interned
  strings) instead of zend_string_free()
- text/plain output unchanged
- test: 7.4's FPM tester has no multiRequest 'delay', so the busy request
  is sent with the raw FastCGI client and the status pages are fetched
  afterwards; also covers query string and xml output and checks that
  the JSON decodes

