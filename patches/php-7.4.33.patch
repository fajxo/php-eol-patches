diff --git a/ext/soap/tests/GHSA-q23r-hr55-xmpg.phpt b/ext/soap/tests/GHSA-q23r-hr55-xmpg.phpt
new file mode 100644
index 00000000..07c18add
--- /dev/null
+++ b/ext/soap/tests/GHSA-q23r-hr55-xmpg.phpt
@@ -0,0 +1,65 @@
+--TEST--
+GHSA-q23r-hr55-xmpg: Out-of-bounds read on empty SOAP-ENC:arraySize
+--EXTENSIONS--
+soap
+--FILE--
+<?php
+
+function echo_back($data) { $GLOBALS['decoded'][] = $data; return null; }
+
+function request(string $arraySize, string $itemType = ''): string {
+    $itemTypeAttribute = $itemType === '' ? '' : "SOAP-ENC:itemType=\"{$itemType}\"";
+
+    return <<<XML
+        <?xml version="1.0"?>
+        <SOAP-ENV:Envelope
+            xmlns:SOAP-ENV="http://schemas.xmlsoap.org/soap/envelope/"
+            xmlns:SOAP-ENC="http://schemas.xmlsoap.org/soap/encoding/"
+            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+            xmlns:xsd="http://www.w3.org/2001/XMLSchema">
+
+            <SOAP-ENV:Body SOAP-ENV:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">
+                <echo_back>
+                    <data xsi:type="SOAP-ENC:Array" {$itemTypeAttribute} SOAP-ENC:arraySize="{$arraySize}">
+                        <item xsi:type="xsd:string">A</item>
+                        <item xsi:type="xsd:string">B</item>
+                        <item xsi:type="xsd:string">C</item>
+                    </data>
+                </echo_back>
+            </SOAP-ENV:Body>
+        </SOAP-ENV:Envelope>
+        XML;
+}
+
+function decode(SoapServer $server, string $request): string {
+    ob_start();
+    $server->handle($request);
+    $response = ob_get_clean();
+
+    if (strpos($response, '<SOAP-ENV:Fault>') !== false) {
+        return 'fault: ' . strip_tags($response);
+    }
+
+    return json_encode(array_pop($GLOBALS['decoded']));
+}
+
+$server = new SoapServer(null, ['uri' => 'http://test']);
+$server->addFunction('echo_back');
+
+$GLOBALS['decoded'] = [];
+
+foreach (['', ' ', 'abc', '*', '3', '2 2'] as $arraySize) {
+    echo var_export($arraySize, true), ' => ', decode($server, request($arraySize)), "\n";
+}
+
+echo "itemType => ", decode($server, request('', 'xsd:string')), "\n";
+
+?>
+--EXPECT--
+'' => ["A","B","C"]
+' ' => ["A","B","C"]
+'abc' => ["A","B","C"]
+'*' => ["A","B","C"]
+'3' => ["A","B","C"]
+'2 2' => [["A","B"],["C"]]
+itemType => ["A","B","C"]
From 789e11ab94d4c3e640751af9aef7d139e06fce9b Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Thu, 19 Nov 2026 16:53:42 +0100
Subject: [PATCH] Fix GHSA-4646-p932-gw34 (CVE-2026-129506): keep SOAP DTD
 alive during cleanup

cleanup_xml_node() freed the DTD node although attribute values with
entity references can still point into it (use-after-free), and removing
it also bypassed SoapServer's "DTD are not supported by SOAP" check for
requests read from php://input. Keep the DTD until the document is
freed.

Backport of php-src 13a0f8c8c1 for EOL 7.4.33. 8.2's cleanup_xml_node()
is iterative and frees nodes in place; 7.4's is recursive with a deferred
"del" pointer, so the same empty XML_DTD_NODE branch is inserted before
the non-element branch (semantic port, same effect: the DTD is neither
freed nor descended into). The test is taken unchanged; in 7.4 the
php://input path of SoapServer::handle() is the one that runs
cleanup_xml_node() (via soap_xmlParseFile), exactly what it exercises.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ext/soap/php_xml.c                      |  3 +++
 ext/soap/tests/GHSA-4646-p932-gw34.phpt | 35 +++++++++++++++++++++++++
 2 files changed, 38 insertions(+)
 create mode 100644 ext/soap/tests/GHSA-4646-p932-gw34.phpt

diff --git a/ext/soap/php_xml.c b/ext/soap/php_xml.c
index 18a26617..b180f19f 100644
--- a/ext/soap/php_xml.c
+++ b/ext/soap/php_xml.c
@@ -54,6 +54,9 @@ static void cleanup_xml_node(xmlNodePtr node)
 			if (is_blank(trav->content)) {
 				del = trav;
 			}
+		} else if (trav->type == XML_DTD_NODE) {
+			/* Attribute-value entity references can share content with the DTD.
+			 * Keep it alive until the document itself is freed. */
 		} else if ((trav->type != XML_ELEMENT_NODE) &&
 		           (trav->type != XML_CDATA_SECTION_NODE)) {
 			del = trav;
