@@ -585,7 +655,7 @@ bail:
 
 		size = (size+511)&~511;
 
-		if (((hdr->typeflag == '\0') || (hdr->typeflag == TAR_FILE)) && size > 0) {
+		if (phar_tar_type_has_data(hdr->typeflag) && size > 0) {
 next:
