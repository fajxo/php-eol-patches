From f7bc8029475522b79a3859ade3f355c8ba12a8ca Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Michal=20Brng=C3=A1l?= <michal@brngal.sk>
Date: Wed, 25 Nov 2026 16:11:08 +0100
Subject: [PATCH] http wrapper: free the dechunk filter and a repeated Location

Two request-scoped leaks in the http:// wrapper, found while porting
the 2026-11-25 fixes to 5.6 (which has both fixes):

- When the request fails after a Transfer-Encoding: chunked header was
  seen (the stream is closed and NULL at out:), the dechunk filter was
  never freed. Only the redirect path freed it.
- A Location header after an empty one allocated a new buffer, because
  "no location yet" was tested with location_len == 0, and the first
  buffer leaked. Test the pointer instead.

Both are emalloc memory freed at request end, so not a security issue;
upstream has the same code.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ext/standard/http_fopen_wrapper.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/ext/standard/http_fopen_wrapper.c b/ext/standard/http_fopen_wrapper.c
index 2eb1f896..8d845552 100644
--- a/ext/standard/http_fopen_wrapper.c
+++ b/ext/standard/http_fopen_wrapper.c
@@ -304,7 +304,7 @@ static zend_bool php_stream_http_response_headers_parse(php_stream_wrapper *wrap
 			zend_string_efree(last_header_line_str);
 			return 0;
 		}
-		if (header_info->location_len == 0) {
+		if (header_info->location == NULL) {
 			header_info->location = emalloc(last_header_value_len + 1);
 		} else if (header_info->location_len <= last_header_value_len) {
 			header_info->location = erealloc(header_info->location, last_header_value_len + 1);
@@ -1213,6 +1213,8 @@ out:
 		if (header_info.transfer_encoding) {
 			php_stream_filter_append(&stream->readfilters, header_info.transfer_encoding);
 		}
+	} else if (header_info.transfer_encoding) {
+		php_stream_filter_free(header_info.transfer_encoding);
 	}
 
 	return stream;
