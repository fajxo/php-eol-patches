+    return $x;
+}
+
+$server = new SoapServer(null, [
+    'uri' => 'urn:t',
+    'style' => SOAP_RPC,
+    'use' => SOAP_ENCODED,
+]);
+$server->addFunction('echo_');
+$server->handle();
