@@ -1477,6 +1477,23 @@ int phar_verify_signature(php_stream *fp, size_t end_of_phar, uint32_t sig_type,
 
 	php_stream_rewind(fp);
 
+	if (sig_type != PHAR_SIG_OPENSSL) {
