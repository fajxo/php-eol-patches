+                   xmlns:xsd="http://www.w3.org/2001/XMLSchema"
+                   xmlns:ns1="urn:t">
+  <SOAP-ENV:Header>
+    <h SOAP-ENV:actor="&e;" SOAP-ENV:mustUnderstand="1"/>
+  </SOAP-ENV:Header>
